---
import { getCollection } from "astro:content";
import ThoughtsLayout from "@layouts/ThoughtsLayout.astro";
import { url } from "@utils/url-utils";

const allThoughts = await getCollection("thoughts", ({ data }) => {
	return import.meta.env.PROD ? data.draft !== true : true;
});

const thoughts = allThoughts.sort(
	(a, b) =>
		new Date(b.data.published).getTime() - new Date(a.data.published).getTime(),
);

// Group by year
const byYear = new Map<number, typeof thoughts>();
for (const t of thoughts) {
	const y = t.data.published.getFullYear();
	const list = byYear.get(y);
	if (list) {
		list.push(t);
	} else {
		byYear.set(y, [t]);
	}
}

function fmtDate(d: Date) {
	return `${String(d.getMonth() + 1).padStart(2, "0")}-${String(d.getDate()).padStart(2, "0")}`;
}

// Collect all unique tags
const allTags = [...new Set(thoughts.flatMap((t) => t.data.tags))].sort();

// Build excerpts from raw markdown body
const excerpts = new Map<string, string>();
for (const t of thoughts) {
	const body = t.body || "";
	// Extract first non-empty paragraph (skip headings, lists, etc.)
	const lines = body.split("\n");
	let excerpt = "";
	for (const line of lines) {
		const trimmed = line.trim();
		if (!trimmed) continue;
		if (
			trimmed.startsWith("#") ||
			trimmed.startsWith("-") ||
			trimmed.startsWith(">") ||
			trimmed.startsWith("*")
		)
			continue;
		// Strip inline markdown: **bold**, *italic*, [links](url), `code`
		excerpt = trimmed
			.replace(/\*\*(.+?)\*\*/g, "$1")
			.replace(/\*(.+?)\*/g, "$1")
			.replace(/\[(.+?)\]\(.+?\)/g, "$1")
			.replace(/`(.+?)`/g, "$1")
			.trim();
		if (excerpt) break;
	}
	if (excerpt) excerpts.set(t.id, excerpt.slice(0, 200));
}
---

<ThoughtsLayout title="偶得" description={`没有长成文章的短念，按时间倒序排列，共 ${thoughts.length} 则。`}>
    <section class="st onload-animation" data-thoughts-index>
        <header class="st-head">
            <p class="st-eyebrow">SERENDIPITY</p>
            <h1 class="st-title">偶得</h1>
            <p class="st-desc">那些没有长成一篇文章的碎念。短的一两行，长的几段话。按时间倒序排列，共 {thoughts.length} 则。</p>
        </header>

        {allTags.length > 0 && (
            <nav class="st-tags" id="st-tags" aria-label="偶得标签筛选">
                <button class="st-tag st-tag--active" type="button" data-filter="all" aria-pressed="true">
                    <span>全部</span>
                    <span class="st-tag-count">{thoughts.length}</span>
                </button>
                {allTags.map((tag) => (
                    <button class="st-tag" type="button" data-filter={tag} aria-pressed="false">
                        <span>#{tag}</span>
                    </button>
                ))}
            </nav>
        )}

        <div class="st-empty" hidden aria-live="polite">这个标签下暂时没有偶得。</div>

        <div class="st-timeline">
            {[...byYear.entries()].map(([year, items]) => (
                <section class="st-year-group" data-year={year}>
                    <header class="st-year">
                        <span class="st-year-num">{year}</span>
                        <span class="st-year-rule" aria-hidden="true"></span>
                        <span class="st-year-count">{items.length} 则</span>
                    </header>
                    <div class="st-year-entries">
                        {items.map((t) => (
                            <a href={url(`/thoughts/${t.id}/`)} class="st-entry" data-tags={t.data.tags.join("|")}>
                                <span class="st-entry-dot" aria-hidden="true"></span>
                                <span class="st-entry-content">
                                    <span class="st-entry-meta">
                                        <time class="st-entry-date">{fmtDate(t.data.published)}</time>
                                        {t.data.tags.length > 0 && (
                                            <span class="st-entry-tags">
                                                {t.data.tags.map((tag: string) => `#${tag}`).join(" / ")}
                                            </span>
                                        )}
                                    </span>
                                    <span class="st-entry-title">{t.data.title}</span>
                                    {excerpts.get(t.id) && (
                                        <span class="st-entry-excerpt">{excerpts.get(t.id)}</span>
                                    )}
                                </span>
                            </a>
                        ))}
                    </div>
                </section>
            ))}
        </div>
    </section>
</ThoughtsLayout>

<script>
    const root = document.querySelector("[data-thoughts-index]") as HTMLElement | null;
    const tagBar = root?.querySelector("#st-tags") as HTMLElement | null;

    if (root && tagBar) {
        const buttons = Array.from(tagBar.querySelectorAll<HTMLButtonElement>(".st-tag"));
        const entries = Array.from(root.querySelectorAll<HTMLElement>(".st-entry"));
        const yearGroups = Array.from(root.querySelectorAll<HTMLElement>(".st-year-group"));
        const empty = root.querySelector<HTMLElement>(".st-empty");

        const applyFilter = (filter = "all") => {
            let visibleCount = 0;

            for (const button of buttons) {
                const active = button.dataset.filter === filter;
                button.classList.toggle("st-tag--active", active);
                button.setAttribute("aria-pressed", String(active));
            }

            for (const entry of entries) {
                const tags = (entry.dataset.tags || "").split("|").filter(Boolean);
                const visible = filter === "all" || tags.includes(filter);
                entry.hidden = !visible;
                if (visible) visibleCount += 1;
            }

            for (const group of yearGroups) {
                group.hidden = !group.querySelector(".st-entry:not([hidden])");
            }

            if (empty) empty.hidden = visibleCount > 0;
        };

        tagBar.addEventListener("click", (event) => {
            const button = (event.target as HTMLElement).closest<HTMLButtonElement>(".st-tag");
            if (!button) return;
            applyFilter(button.dataset.filter || "all");
        });
    }
</script>

<style is:global>
    .st {
        --st-accent: var(--thoughts-accent, oklch(0.67 0.22 24));
        --st-muted: color-mix(in srgb, var(--text-muted) 84%, transparent);
        --st-faint: color-mix(in srgb, var(--text-muted) 28%, transparent);
        width: min(100%, 48rem);
        margin: 0 auto;
        padding: clamp(4rem, 9vw, 6.5rem) clamp(1rem, 4vw, 1.5rem) 2rem;
    }

    .st-head {
        margin-bottom: clamp(2rem, 5vw, 3.75rem);
    }

    .st-eyebrow {
        margin: 0 0 0.8rem;
        color: var(--st-accent);
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.24em;
    }

    .st-title {
        position: relative;
        margin: 0;
        padding-left: 1rem;
        color: var(--text-strong);
        font-family: var(--sk-font-display);
        font-size: clamp(2.3rem, 8vw, 4.4rem);
        font-weight: 600;
        line-height: 1.08;
        letter-spacing: 0;
        text-wrap: balance;
    }

    .st-title::before {
        content: "";
        position: absolute;
        left: 0;
        top: 0.2em;
        bottom: 0.2em;
        width: 3px;
        border-radius: 999px;
        background: var(--st-accent);
    }

    .st-desc {
        max-width: 40rem;
        margin: 1rem 0 0;
        color: var(--st-muted);
        font-family: var(--sk-font-han);
        font-size: 0.98rem;
        line-height: 1.9;
        text-wrap: pretty;
    }

    .st-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.55rem;
        margin-bottom: clamp(2.2rem, 5vw, 3.5rem);
    }

    .st-tag {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        min-height: 2.05rem;
        padding: 0.35rem 0.82rem;
        border: 1px solid color-mix(in srgb, var(--glass-border) 78%, transparent);
        border-radius: 999px;
        background: color-mix(in srgb, var(--card-bg-solid) 28%, transparent);
        color: var(--st-muted);
        font-size: 0.82rem;
        font-weight: 500;
        line-height: 1;
        cursor: pointer;
        transition:
            color 180ms var(--motion-standard),
            border-color 180ms var(--motion-standard),
            background 180ms var(--motion-standard),
            transform 180ms var(--motion-standard);
    }

    .st-tag:hover {
        transform: translateY(-1px);
        border-color: color-mix(in srgb, var(--st-accent) 45%, var(--glass-border));
        color: var(--text-strong);
    }

    .st-tag:focus-visible {
        outline: 2px solid color-mix(in srgb, var(--st-accent) 65%, transparent);
        outline-offset: 3px;
    }

    .st-tag--active {
        border-color: var(--text-strong);
        background: var(--text-strong);
        color: var(--page-bg);
    }

    .st-tag-count {
        font-size: 0.72rem;
        opacity: 0.72;
        font-variant-numeric: tabular-nums;
    }

    .st-empty {
        margin: 2rem 0;
        padding: 1.4rem 0;
        border-top: 1px solid var(--line-divider);
        border-bottom: 1px solid var(--line-divider);
        color: var(--st-muted);
        font-family: var(--sk-font-han);
        text-align: center;
    }

    .st-timeline {
        display: grid;
        gap: clamp(2.6rem, 6vw, 4.5rem);
    }

    .st-year {
        display: grid;
        grid-template-columns: auto minmax(2rem, 1fr) auto;
        align-items: center;
        gap: 1rem;
        margin-bottom: 1.25rem;
    }

    .st-year-num {
        color: var(--text-muted);
        font-size: 1rem;
        font-weight: 800;
        letter-spacing: 0.16em;
        font-variant-numeric: tabular-nums;
    }

    .st-year-rule {
        height: 1px;
        background: linear-gradient(90deg, var(--line-divider), transparent);
    }

    .st-year-count {
        color: color-mix(in srgb, var(--text-muted) 58%, transparent);
        font-size: 0.78rem;
        font-variant-numeric: tabular-nums;
        white-space: nowrap;
    }

    .st-year-entries {
        position: relative;
        display: grid;
        gap: 0.25rem;
        padding-left: 1.5rem;
    }

    .st-year-entries::before {
        content: "";
        position: absolute;
        left: 0.22rem;
        top: 0.9rem;
        bottom: 0.9rem;
        width: 1px;
        background: linear-gradient(180deg, var(--st-faint), color-mix(in srgb, var(--st-faint) 36%, transparent));
    }

    .st-entry {
        position: relative;
        display: grid;
        grid-template-columns: auto minmax(0, 1fr);
        gap: 1.05rem;
        padding: 1.05rem 0;
        color: inherit;
        text-decoration: none;
    }

    .st-entry + .st-entry {
        border-top: 1px solid color-mix(in srgb, var(--line-divider) 70%, transparent);
    }

    .st-entry[hidden] {
        display: none;
    }

    .st-entry-dot {
        position: relative;
        z-index: 1;
        width: 0.48rem;
        height: 0.48rem;
        margin-top: 0.48rem;
        border: 1px solid var(--st-accent);
        border-radius: 999px;
        background: var(--page-bg-soft);
        transition:
            background 180ms var(--motion-standard),
            transform 180ms var(--motion-standard),
            box-shadow 180ms var(--motion-standard);
    }

    .st-entry-content {
        display: grid;
        min-width: 0;
        gap: 0.4rem;
    }

    .st-entry-meta {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        gap: 0.6rem;
        color: color-mix(in srgb, var(--text-muted) 70%, transparent);
        font-size: 0.78rem;
        line-height: 1.4;
    }

    .st-entry-date {
        font-weight: 600;
        font-variant-numeric: tabular-nums;
        letter-spacing: 0.04em;
    }

    .st-entry-tags {
        color: color-mix(in srgb, var(--st-accent) 72%, var(--text-muted));
    }

    .st-entry-title {
        color: var(--text-strong);
        font-family: var(--sk-font-han);
        font-size: clamp(1.05rem, 2vw, 1.22rem);
        font-weight: 700;
        line-height: 1.55;
        text-wrap: pretty;
        transition: color 180ms var(--motion-standard);
    }

    .st-entry-excerpt {
        display: -webkit-box;
        max-width: 42rem;
        overflow: hidden;
        color: var(--st-muted);
        font-family: var(--sk-font-han);
        font-size: 0.94rem;
        line-height: 1.85;
        text-wrap: pretty;
        -webkit-box-orient: vertical;
        -webkit-line-clamp: 3;
    }

    .st-entry:hover .st-entry-title {
        color: color-mix(in srgb, var(--st-accent) 76%, var(--text-strong));
    }

    .st-entry:hover .st-entry-dot {
        transform: scale(1.35);
        background: var(--st-accent);
        box-shadow: 0 0 0 5px color-mix(in srgb, var(--st-accent) 13%, transparent);
    }

    .st-entry:focus-visible {
        outline: 2px solid color-mix(in srgb, var(--st-accent) 60%, transparent);
        outline-offset: 6px;
        border-radius: 0.5rem;
    }

    @media (max-width: 640px) {
        .st {
            padding-top: 3.25rem;
        }

        .st-title {
            padding-left: 0.82rem;
        }

        .st-year {
            gap: 0.7rem;
        }

        .st-year-entries {
            padding-left: 1.1rem;
        }

        .st-entry {
            gap: 0.75rem;
            padding: 0.95rem 0;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .st-tag,
        .st-entry-dot,
        .st-entry-title {
            transition: none;
        }
        .st-tag:hover,
        .st-entry:hover .st-entry-dot {
            transform: none;
        }
    }
</style>
