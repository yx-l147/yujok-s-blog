---
import BackToTop from "@components/control/BackToTop.astro";
import Footer from "@components/Footer.astro";
import Navbar from "@components/Navbar.astro";
import RightSideBar from "@components/widget/RightSideBar.astro";
import SideBar from "@components/widget/SideBar.astro";
import type { MarkdownHeading } from "astro";
import { Icon } from "astro-icon/components";
import ImageWrapper from "../components/misc/ImageWrapper.astro";
import { siteConfig } from "../config";
import {
	BANNER_HEIGHT,
	BANNER_HEIGHT_EXTEND,
	MAIN_PANEL_OVERLAPS_BANNER_HEIGHT,
} from "../constants/constants";
import Layout from "./Layout.astro";

interface Props {
	title?: string;
	banner?: string;
	description?: string;
	lang?: string;
	setOGTypeArticle?: boolean;
	ogType?: string;
	ogImage?: string;
	ogImageAlt?: string;
	twitterCard?: "summary" | "summary_large_image";
	headings?: MarkdownHeading[];
	fullWidth?: boolean;
	disableBanner?: boolean;
}

const {
	title,
	banner,
	description,
	lang,
	setOGTypeArticle,
	ogType,
	ogImage,
	ogImageAlt,
	twitterCard,
	headings = [],
	fullWidth = false,
	disableBanner = false,
} = Astro.props;
const hasBannerCredit =
	siteConfig.banner.enable && siteConfig.banner.credit.enable;
const hasBannerLink = !!siteConfig.banner.credit.url;

const mainPanelTop =
	siteConfig.banner.enable && !disableBanner
		? `calc(${BANNER_HEIGHT}vh - ${MAIN_PANEL_OVERLAPS_BANNER_HEIGHT}rem)`
		: "5.5rem";
---

<Layout
    title={title}
    banner={banner}
    description={description}
    lang={lang}
    setOGTypeArticle={setOGTypeArticle}
    ogType={ogType}
    ogImage={ogImage}
    ogImageAlt={ogImageAlt}
    twitterCard={twitterCard}
    disableBanner={disableBanner}
>

<!-- Navbar -->
<slot slot="head" name="head"></slot>
<div id="top-row" class="z-50 pointer-events-none relative max-w-[var(--page-width)] px-0 md:px-4 mx-auto" class:list={[""]}>
    <div id="navbar-wrapper" class="pointer-events-auto sticky top-0 pt-2 md:pt-4 transition-[opacity,transform] duration-300">
        <Navbar></Navbar>
    </div>
</div>

<!-- Banner -->
{siteConfig.banner.enable && <div id="banner-wrapper" class={`absolute z-10 w-full transition duration-700 overflow-hidden`} style={`top: -${BANNER_HEIGHT_EXTEND}vh`} hidden={disableBanner}>
    <ImageWrapper id="banner" alt="Banner image of the blog" class:list={["object-cover h-full transition duration-700 opacity-0 scale-105"]}
                  src={siteConfig.banner.src} position={siteConfig.banner.position}
    >
    </ImageWrapper>
</div>}

<!-- Main content -->
<div id="main-shell" class="absolute w-full z-30 pointer-events-none" style={`top: ${mainPanelTop}`}>
    <div class="relative max-w-[var(--page-width)] mx-auto pointer-events-auto">
        <div id="main-grid" class:list={[
            "w-full left-0 right-0 grid grid-cols-[17.5rem_auto] xl:grid-cols-[17.5rem_minmax(0,1fr)_17.5rem] grid-rows-[auto_1fr_auto] lg:grid-rows-[auto] mx-auto gap-4 px-0 md:px-4",
            { "content-fullwidth": fullWidth },
        ]}
        >
            <!-- Banner image credit -->
            {hasBannerCredit && <a href={siteConfig.banner.credit.url} id="banner-credit" target="_blank" rel="noopener" aria-label="Visit image source" hidden={disableBanner}
                                   class:list={["group onload-animation transition-all absolute flex justify-center items-center rounded-full " +
                                   "px-3 right-4 -top-[3.25rem] bg-black/60 hover:bg-black/70 h-9", {"hover:pr-9 active:bg-black/80": hasBannerLink}]}
            >
                <Icon class="text-white/75 text-[1.25rem] mr-1" name="material-symbols:copyright-outline-rounded" ></Icon>
                <div class="text-white/75 text-xs">{siteConfig.banner.credit.text}</div>
                <Icon class:list={["transition absolute text-[oklch(0.75_0.14_var(--hue))] right-4 text-[0.75rem] opacity-0",
                    {"group-hover:opacity-100": hasBannerLink}]}
                      name="fa6-solid:arrow-up-right-from-square">
                </Icon>
            </a>}

            <SideBar class="mb-4 row-start-2 row-end-3 col-span-2 xl:col-span-1 lg:row-start-1 lg:row-end-2 lg:col-span-1 lg:max-w-[17.5rem] onload-animation" headings={headings}></SideBar>

            <!-- Swup needs #toc container on every page -->
            <div id="toc" style="display:none"></div>

            <main id="swup-container" class="transition-swup-fade col-span-2 lg:col-span-1 xl:col-span-1 overflow-hidden">
                <div id="content-wrapper" class="onload-animation">
                    <div
                        data-layout-full-width={fullWidth ? "true" : "false"}
                        data-layout-disable-banner={disableBanner ? "true" : "false"}
                        hidden
                    ></div>
                    <slot></slot>
                    <div class="footer col-span-2 xl:col-span-3 onload-animation hidden lg:block">
                        <Footer></Footer>
                    </div>
                </div>
            </main>

            {siteConfig.rightSidebar.enable && (
                <RightSideBar class="hidden xl:block mb-4 xl:row-start-1 xl:row-end-2 xl:col-start-3 xl:col-end-4 xl:max-w-[17.5rem] onload-animation" />
            )}

            <div class="footer col-span-2 xl:col-span-3 onload-animation block lg:hidden">
                <Footer></Footer>
            </div>
        </div>

        <BackToTop></BackToTop>
    </div>
</div>

<style is:global>
    :root.right-sidebar-collapsed #main-grid > .footer {
        @apply xl:col-span-2;
    }

    :root.left-sidebar-collapsed #main-grid > .footer {
        @apply xl:col-span-2;
    }

    :root.left-sidebar-collapsed.right-sidebar-collapsed #main-grid > .footer {
        @apply xl:col-span-1;
    }

    /* 全宽内容页 */
    #main-grid.content-fullwidth {
        grid-template-columns: 1fr !important;
    }
    #main-grid.content-fullwidth > :not(#swup-container):not(#toc):not(.footer):not(#banner-credit) {
        display: none !important;
    }
</style>

<script>
    function syncPersistentLayoutShell() {
        const grid = document.querySelector("#main-grid") as HTMLElement | null;
        const marker = document.querySelector("[data-layout-full-width]") as HTMLElement | null;
        const bannerMarker = document.querySelector("[data-layout-disable-banner]") as HTMLElement | null;
        const isFullWidthPage = marker?.dataset.layoutFullWidth === "true";
        const isBannerDisabled = bannerMarker?.dataset.layoutDisableBanner === "true";
        const bannerWrapper = document.getElementById("banner-wrapper");
        const bannerCredit = document.getElementById("banner-credit");

        if (grid) {
            grid.classList.toggle("content-fullwidth", !!isFullWidthPage);
        }

        const shouldShowBanner = !isBannerDisabled && !!bannerWrapper;
        document.body.classList.toggle("enable-banner", shouldShowBanner);

        if (bannerWrapper) {
            bannerWrapper.hidden = !shouldShowBanner;
            bannerWrapper.setAttribute("aria-hidden", String(!shouldShowBanner));
        }

        if (bannerCredit) {
            bannerCredit.hidden = !shouldShowBanner;
            bannerCredit.setAttribute("aria-hidden", String(!shouldShowBanner));
        }
    }

    function bindAurora() {
        const cards = document.querySelectorAll("#right-sidebar widget-layout");
        for (const card of cards) {
            if ((card as HTMLElement).dataset.auroraBound) continue;
            (card as HTMLElement).dataset.auroraBound = "1";
            card.addEventListener("pointermove", (e) => {
                const ev = e as PointerEvent;
                const r = (card as HTMLElement).getBoundingClientRect();
                const mx = ((ev.clientX - r.left) / r.width) * 100;
                const my = ((ev.clientY - r.top) / r.height) * 100;
                (card as HTMLElement).style.setProperty("--rs-mx", `${mx}%`);
                (card as HTMLElement).style.setProperty("--rs-my", `${my}%`);
            });
        }
    }
    bindAurora();
    document.addEventListener("swup:page:view", () => bindAurora());

    function syncContentFullWidth() {
        syncPersistentLayoutShell();
    }
    syncContentFullWidth();
    document.addEventListener("swup:content:replace", syncContentFullWidth);
    document.addEventListener("swup:page:view", syncContentFullWidth);

    const THOUGHTS_DETAIL_CLASS = "thoughts-detail-active";
    const THOUGHTS_NAV_PORTAL = "data-thoughts-nav-portal";
    const desktopThoughtsNavQuery = "(min-width: 901px)";

    function removePortaledThoughtNavs(except?: Element | null) {
        for (const nav of document.querySelectorAll(`[${THOUGHTS_NAV_PORTAL}="true"]`)) {
            if (nav !== except) nav.remove();
        }
    }

    function syncThoughtsDetailNav() {
        const page = document.querySelector(".sa-page");
        const slot = page?.querySelector(".sa-nav-slot");
        const slotNav = slot?.querySelector(".sa-nav");
        const portaledNav = document.querySelector(`.sa-nav[${THOUGHTS_NAV_PORTAL}="true"]`);
        const nav = slotNav || portaledNav;

        document.documentElement.classList.toggle(THOUGHTS_DETAIL_CLASS, !!page);

        if (!page || !slot || !nav) {
            removePortaledThoughtNavs();
            return;
        }

        const shouldPortal = window.matchMedia(desktopThoughtsNavQuery).matches;
        if (shouldPortal) {
            removePortaledThoughtNavs(nav);
            nav.setAttribute(THOUGHTS_NAV_PORTAL, "true");
            document.body.append(nav);
        } else {
            nav.removeAttribute(THOUGHTS_NAV_PORTAL);
            slot.append(nav);
            removePortaledThoughtNavs(nav);
        }
    }

    syncThoughtsDetailNav();
    window.addEventListener("resize", syncThoughtsDetailNav, { passive: true });
    document.addEventListener("swup:content:replace", syncThoughtsDetailNav);
    document.addEventListener("swup:page:view", syncThoughtsDetailNav);
    document.addEventListener("astro:page-load", syncThoughtsDetailNav);
    document.addEventListener("swup:visit:start", () => {
        document.documentElement.classList.remove(THOUGHTS_DETAIL_CLASS);
        removePortaledThoughtNavs();
    });
</script>

</Layout>
