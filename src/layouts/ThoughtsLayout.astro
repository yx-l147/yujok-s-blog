---
import type { MarkdownHeading } from "astro";
import MainGridLayout from "./MainGridLayout.astro";

interface Props {
	title?: string;
	description?: string;
	lang?: string;
	headings?: MarkdownHeading[];
}

const { title, description, lang, headings = [] } = Astro.props;
---

<MainGridLayout
    title={title}
    description={description}
    lang={lang}
    headings={headings}
    fullWidth
    disableBanner
>
    <slot slot="head" name="head" />
    <slot />
</MainGridLayout>
