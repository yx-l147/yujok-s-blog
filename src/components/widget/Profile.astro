---
import { Icon } from "astro-icon/components";
import { profileConfig } from "../../config";
import { url } from "../../utils/url-utils";
import ImageWrapper from "../misc/ImageWrapper.astro";

const config = profileConfig;
---

<section class="glass-panel card-base p-4">
    <a aria-label="Go to About Page" href={url("/about/")}
       class="group block relative mx-auto mb-4 overflow-hidden rounded-[1rem] active:scale-95">
        <div class="absolute inset-0 z-20 transition pointer-events-none bg-black/0 group-hover:bg-black/25 group-active:bg-black/45 flex items-center justify-center">
            <Icon name="fa6-regular:address-card"
                  class="transition opacity-0 scale-90 group-hover:scale-100 group-hover:opacity-100 text-white text-5xl" />
        </div>
        <ImageWrapper src={config.avatar || ""} alt="Profile Image of the Author" class="mx-auto lg:w-full h-full" />
    </a>
    <div>
        <div class="text-xl font-bold text-center mb-1 text-90 transition">{config.name}</div>
        <div class="h-1 w-6 bg-[var(--primary)] mx-auto rounded-full mb-3 transition"></div>
        <div class="text-center text-50 mb-4 leading-7 text-sm">{config.bio}</div>
        <div class="flex flex-wrap gap-2 justify-center mb-1">
            {config.links.map((item) => (
                <a rel="me" aria-label={item.name} href={item.url} target="_blank" class="btn-regular rounded-lg h-10 w-10 active:scale-90">
                    <Icon name={item.icon} class="text-[1.5rem]" />
                </a>
            ))}
        </div>
    </div>
</section>
