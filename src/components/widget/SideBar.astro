---
import type { MarkdownHeading } from "astro";
import { siteConfig } from "../../config";
import Categories from "./Categories.astro";
import Profile from "./Profile.astro";
import Tag from "./Tags.astro";
import ThoughtsPreview from "./ThoughtsPreview.astro";
import TOC from "./TOC.astro";
import WidgetLayout from "./WidgetLayout.astro";

interface Props {
	class?: string;
	headings?: MarkdownHeading[];
}

const className = Astro.props.class;
const headings = Astro.props.headings || [];
const showToc = siteConfig.toc.enable && headings.length > 0;
---

<aside id="sidebar" class:list={[className, "w-full"]}>
    <div class="flex flex-col w-full gap-4 mb-4">
        <Profile />
    </div>
    <div id="sidebar-sticky" class="flex flex-col w-full gap-4 top-4 sticky">
        {showToc && (
            <WidgetLayout name="目录" id="toc-panel" class="onload-animation" style="animation-delay: 125ms">
                <div id="toc-wrapper" class="transition">
                    <div id="toc-inner-wrapper" class="max-h-[48vh] overflow-y-auto overflow-x-hidden hide-scrollbar pr-1">
                        <div id="toc" class="relative">
                            <TOC headings={headings} />
                        </div>
                    </div>
                </div>
            </WidgetLayout>
        )}
        {!showToc && <div id="toc" class="hidden"></div>}
        <Categories class="onload-animation" style="animation-delay: 150ms" />
        <Tag class="onload-animation" style="animation-delay: 200ms" />
        <WidgetLayout name="偶得速览" id="thoughts-preview" class="onload-animation" style="animation-delay: 250ms">
            <ThoughtsPreview />
        </WidgetLayout>
    </div>
</aside>
