---
import type { CollectionEntry } from "astro:content";
import path from "node:path";
import { Icon } from "astro-icon/components";
import { getPostExcerpt } from "../utils/content-utils";
import { getDir } from "../utils/url-utils";
import ImageWrapper from "./misc/ImageWrapper.astro";
import PostMetadata from "./PostMeta.astro";

interface Props {
	class?: string;
	entry: CollectionEntry<"posts">;
	title: string;
	url: string;
	published: Date;
	updated?: Date;
	tags: string[];
	category: string | null;
	image: string;
	description: string;
	draft: boolean;
	words?: number;
	minutes?: number;
	style: string;
}
const {
	entry,
	title,
	url,
	published,
	updated,
	tags,
    category,
    image,
    description,
    words,
    minutes,
    style,
} = Astro.props;
const className = Astro.props.class;

const hasCover = image !== undefined && image !== null && image !== "";
const excerpt = description || (await getPostExcerpt(entry));
---

<article class:list={["card-base glass-panel post-card group flex flex-col-reverse w-full rounded-[var(--radius-large)] overflow-hidden relative", {"md:grid md:grid-cols-[minmax(0,1fr)_clamp(12rem,30%,18rem)] md:items-stretch": hasCover, "md:flex-col": !hasCover}, className]} style={style}>
    <div class="pl-6 md:pl-8 pr-6 md:pr-5 pt-6 md:pt-7 pb-6 relative min-w-0 md:col-start-1 md:row-start-1">
        <a href={url}
           class="transition block font-bold mb-3 text-[1.65rem]/[2.15rem] md:text-3xl text-90
        hover:text-[var(--primary)] dark:hover:text-[var(--primary)]
        active:text-[var(--title-active)] dark:active:text-[var(--title-active)]
        before:w-1 before:h-5 before:rounded-full before:bg-[var(--primary)]
        before:absolute before:top-[35px] before:left-[18px] before:hidden md:before:block
        ">
            {title}
            <Icon class="text-[var(--primary)] text-[2rem] transition hidden md:inline absolute translate-y-0.5 opacity-0 group-hover:opacity-100 -translate-x-1 group-hover:translate-x-0" name="material-symbols:chevron-right-rounded" />
        </a>

        <PostMetadata published={published} updated={updated} tags={tags} category={category} hideTagsForMobile={true} hideUpdateDate={true} class="mb-4" />

        <div class="transition text-75 mb-4 pr-4 line-clamp-2 md:line-clamp-2 leading-7">
            {excerpt}
        </div>

        {words !== undefined && minutes !== undefined && <div class="post-card__stats text-50">
            <span>{words} 字</span>
            <span class="post-card__stats-divider" aria-hidden="true"></span>
            <span>{minutes} 分钟</span>
        </div>}
    </div>

    {hasCover && <a href={url} aria-label={title}
                    class:list={["group/cover",
                        "mx-4 mt-4 -mb-2 aspect-[16/9] md:mx-0 md:my-3 md:mr-3 md:mb-3 md:aspect-[4/3] md:min-h-0",
                        "relative md:col-start-2 md:row-start-1 md:self-stretch rounded-xl overflow-hidden active:scale-95"
                    ]} >
        <div class="absolute pointer-events-none z-10 w-full h-full group-hover/cover:bg-black/25 group-active/cover:bg-black/45 transition"></div>
        <div class="absolute pointer-events-none z-20 w-full h-full flex items-center justify-center">
            <Icon name="material-symbols:chevron-right-rounded"
                  class="transition opacity-0 group-hover/cover:opacity-100 scale-50 group-hover/cover:scale-100 text-white text-5xl" />
        </div>
        <ImageWrapper src={image} basePath={path.join("content/posts/", getDir(entry.id))} alt="Cover Image of the Post"
                  class="w-full h-full" />
    </a>}

</article>
<div class="transition border-t-[1px] border-dashed mx-6 border-black/10 dark:border-white/[0.15] last:border-t-0 md:hidden"></div>
