---
import type { BookNote } from "@/types/weread";

interface Props {
  notes: BookNote[];
  limit?: number;
}
const { notes, limit = 6 } = Astro.props;
const items = notes.slice(0, limit);
---

{items.length > 0 && (
  <section class="note-wall sk-rise" data-delay="6">
    <div class="note-head">
      <h3 class="note-title sk-han">
        <span class="note-eyebrow sk-script">marginalia</span>
        摘 · 抄 · 与 · 划 · 痕
      </h3>
      <p class="note-sub">每一句被点亮的字，都是夜空里漂浮的星屑</p>
    </div>

    <div class="note-grid">
      {items.map((n, i) => (
        <article class="note-card sk-glass sk-aurora sk-rise" data-delay={Math.min(i+1, 8)}>
          <div class="note-quote">
            <span class="quote-mark" aria-hidden="true">「</span>
            <p class="note-text sk-han">{n.text}</p>
            <span class="quote-mark quote-end" aria-hidden="true">」</span>
          </div>
          {n.comment && (
            <p class="note-comment">— {n.comment}</p>
          )}
          <div class="note-meta">
            <span class="meta-book">《{n.bookTitle}》</span>
            {n.chapter && <span class="meta-chapter">· {n.chapter}</span>}
            <time class="meta-time">{new Date(n.createTime).toLocaleDateString("zh-CN", { month: "short", day: "numeric" })}</time>
          </div>
        </article>
      ))}
    </div>
  </section>
)}

<style>
  .note-wall {
    margin: 2rem 0 2.5rem;
  }
  .note-head {
    margin-bottom: 1.5rem;
  }
  .note-title {
    font-size: 1.55rem;
    color: var(--sk-moon);
    margin: 0;
    line-height: 1;
    display: flex;
    flex-direction: column;
    gap: .2rem;
  }
  .note-eyebrow {
    font-size: 1.4rem;
    color: var(--sk-sakura);
    line-height: 1;
  }
  .note-sub {
    font-size: .85rem;
    color: color-mix(in srgb, var(--sk-moon) 60%, transparent);
    margin: .4rem 0 0;
  }

  .note-grid {
    columns: 2 320px;
    column-gap: 1.4rem;
  }
  .note-card {
    break-inside: avoid;
    margin-bottom: 1.4rem;
    padding: 1.5rem 1.6rem 1.2rem;
    transition: transform .4s var(--sk-ease-out);
  }
  .note-card:hover {
    transform: translateY(-3px);
  }

  .note-quote {
    position: relative;
  }
  .quote-mark {
    font-family: var(--sk-font-han);
    color: color-mix(in srgb, var(--sk-comet) 70%, transparent);
    font-size: 1.4rem;
    line-height: 1;
  }
  .quote-end {
    float: right;
    margin-top: -.5rem;
  }
  .note-text {
    font-size: 1.02rem;
    line-height: 1.7;
    color: var(--sk-moon);
    margin: .2rem 0;
    text-indent: 0;
  }
  .note-comment {
    margin: .8rem 0 0;
    color: color-mix(in srgb, var(--sk-sunset) 75%, var(--sk-moon));
    font-size: .9rem;
    font-style: italic;
    padding-left: 1rem;
    border-left: 2px solid color-mix(in srgb, var(--sk-sunset) 60%, transparent);
  }
  .note-meta {
    display: flex;
    align-items: center;
    gap: .5rem;
    margin-top: 1.1rem;
    padding-top: .8rem;
    border-top: 1px dashed color-mix(in srgb, var(--sk-moon) 18%, transparent);
    font-size: .76rem;
    color: color-mix(in srgb, var(--sk-moon) 60%, transparent);
    flex-wrap: wrap;
  }
  .meta-book {
    color: var(--sk-river);
    font-weight: 600;
  }
  .meta-time {
    margin-left: auto;
    font-family: var(--sk-font-display);
  }
</style>
