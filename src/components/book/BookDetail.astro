---
import type { BookItem, BookNote } from "@/types/weread";
import { shortCategory } from "@/data/shelf";

interface Props {
  book: BookItem;
  notes: BookNote[];
  allBooks: BookItem[];
}

const { book, notes, allBooks } = Astro.props;

const statusLabel: Record<string, string> = {
  reading: "在读",
  finished: "读完",
  wishlist: "想读",
};

const hours = book.readTime ? Math.round(book.readTime / 3600) : 0;
const publishYear = book.publishTime
  ? new Date(book.publishTime).getFullYear()
  : null;

// 同分类相关书籍
const topCat = (book.category || "").split("-")[0];
const related = allBooks
  .filter((b) => b.bookId !== book.bookId && (b.category || "").startsWith(topCat))
  .sort((a, b) => (b.publicRating ?? 0) - (a.publicRating ?? 0))
  .slice(0, 4);
const wereadUrl = `https://weread.qq.com/web/search/books?keyword=${encodeURIComponent(
  `${book.title} ${book.author}`.trim(),
)}`;
const visibleNotes = notes.slice(0, 2);
const hiddenNotes = notes.slice(2);
---

<article class="detail">
  <!-- 左栏：封面 -->
  <aside class="detail-side">
    <div class="detail-cover">
      <img
        src={book.cover}
        alt={book.title}
        loading="eager"
        decoding="async"
      />
      <div class="detail-cover-sheen" aria-hidden="true"></div>
    </div>

    <div class="detail-status">
      <span
        class="status-dot"
        style={`background:${
          book.status === "reading"
            ? "var(--sk-comet)"
            : book.status === "finished"
              ? "var(--sk-river)"
              : "var(--sk-sakura)"
        }`}
      ></span>
      {statusLabel[book.status] ?? "未知"}
    </div>

    {book.status === "reading" && book.progress > 0 && (
      <div class="detail-progress">
        <div class="progress-bar">
          <span class="progress-fill" style={`width:${book.progress}%`}></span>
        </div>
        <span class="progress-text">已读 {book.progress}%</span>
      </div>
    )}

    <!-- 外链 -->
    <a
      href={wereadUrl}
      class="detail-weread-btn"
      target="_blank"
      rel="noopener noreferrer"
    >
      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
        <polyline points="15 3 21 3 21 9"/>
        <line x1="10" y1="14" x2="21" y2="3"/>
      </svg>
      在微信读书中打开
    </a>
  </aside>

  <!-- 右栏：信息 -->
  <div class="detail-main">
    <!-- 面包屑 -->
    <nav class="detail-breadcrumb">
      <a href="/book/">← 返回书架</a>
    </nav>

    <!-- 标题区 -->
    <header class="detail-header">
      <h1 class="detail-title sk-han">{book.title}</h1>
      <p class="detail-author">
        {book.author}
        {book.translator && <span class="detail-translator"> · 译/ {book.translator}</span>}
      </p>

      <div class="detail-meta-line">
        {book.publisher && <span class="meta-chip">{book.publisher}</span>}
        {book.category && <span class="meta-chip">{shortCategory(book.category)}</span>}
        {publishYear && (
          <span class="meta-chip">{publishYear}</span>
        )}
      </div>

      <!-- 评分 -->
      {book.publicRating && book.publicRating > 0 && (
        <div class="detail-rating">
          <span class="rating-stars">
            {Array.from({ length: 5 }, (_, i) => (
              <svg
                viewBox="0 0 24 24"
                width="16"
                height="16"
                fill={i < Math.round(book.publicRating! / 2) ? "currentColor" : "none"}
                stroke="currentColor"
                stroke-width="1.5"
              >
                <path d="M12 2l2.9 6.9L22 10l-5.5 4.7L18 22l-6-3.6L6 22l1.5-7.3L2 10l7.1-1.1z"/>
              </svg>
            ))}
          </span>
          <span class="rating-num">{book.publicRating.toFixed(1)}</span>
          {book.ratingCount && (
            <span class="rating-count">{book.ratingCount} 人评价</span>
          )}
        </div>
      )}
    </header>

    <!-- 个人阅读数据 -->
    <div class="detail-stats">
      {hours > 0 && (
        <div class="dstat">
          <span class="dstat-num">{hours}</span>
          <span class="dstat-label">小时</span>
        </div>
      )}
      <div class="dstat">
        <span class="dstat-num">{book.noteCount ?? 0}</span>
        <span class="dstat-label">笔记</span>
      </div>
      <div class="dstat">
        <span class="dstat-num">{book.bookmarkCount ?? 0}</span>
        <span class="dstat-label">划线</span>
      </div>
      {book.reviewCount !== undefined && book.reviewCount > 0 && (
        <div class="dstat">
          <span class="dstat-num">{book.reviewCount}</span>
          <span class="dstat-label">书评</span>
        </div>
      )}
    </div>

    <!-- 简介 -->
    {book.intro && (
      <section class="detail-section detail-section--intro">
        <h2 class="section-title sk-han">简介</h2>
        <div class="detail-intro">
          {book.intro.split("\n").map((p) =>
            p.trim() ? <p>{p.trim()}</p> : null
          )}
        </div>
      </section>
    )}

    <!-- 我的笔记 -->
    <section class="detail-section detail-section--notes" data-notes-section>
      <div class="notes-head">
        <h2 class="section-title sk-han">
          我的笔记
          <span class="section-count">{notes.length}</span>
        </h2>
        {hiddenNotes.length > 0 && (
          <button type="button" class="notes-toggle" data-notes-toggle aria-expanded="false">
            查看全部
          </button>
        )}
      </div>

      {notes.length > 0 ? (
        <div class="notes-list">
          {visibleNotes.map((n) => (
            <blockquote class="note-item">
              <p class="note-text sk-han">{n.text}</p>
              {n.chapter && (
                <footer class="note-chapter">- {n.chapter}</footer>
              )}
            </blockquote>
          ))}
          {hiddenNotes.map((n) => (
            <blockquote class="note-item is-note-extra">
              <p class="note-text sk-han">{n.text}</p>
              {n.chapter && (
                <footer class="note-chapter">- {n.chapter}</footer>
              )}
            </blockquote>
          ))}
        </div>
      ) : (
        <div class="notes-empty">
          <p class="notes-empty-title sk-han">暂无公开笔记</p>
          <p>如果微信读书里后来新增了划线或想法，重新同步数据后这里会自动出现。</p>
        </div>
      )}
    </section>

    <!-- 相关书籍 -->
    {related.length > 0 && (
      <section class="detail-section detail-section--related">
        <h2 class="section-title sk-han">同类书籍</h2>
        <div class="related-grid">
          {related.map((b) => (
            <a href={`/book/${b.bookId}/`} class="related-card" title={b.title}>
              <div class="related-cover">
                <img src={b.cover} alt={b.title} loading="lazy" />
              </div>
              <span class="related-title">{b.title}</span>
            </a>
          ))}
        </div>
      </section>
    )}
  </div>
</article>

<style>
  .detail {
    display: grid;
    grid-template-columns: minmax(220px, 280px) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
    max-width: 1120px;
    margin: 0 auto;
    padding: 1.5rem 0 3rem;
  }

  /* 左栏 */
  .detail-side {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    grid-column: 1;
    grid-row: 1 / span 3;
  }

  .detail-cover {
    position: relative;
    border-radius: 14px;
    overflow: hidden;
    box-shadow:
      0 12px 40px rgba(20, 40, 80, 0.22),
      0 4px 12px rgba(20, 40, 80, 0.12);
  }
  .detail-cover img {
    width: 100%;
    display: block;
    aspect-ratio: 3 / 4.35;
    object-fit: cover;
  }
  .detail-cover-sheen {
    position: absolute;
    inset: 0;
    background: linear-gradient(115deg, transparent 40%, rgba(255,255,255,.14) 50%, transparent 60%);
    pointer-events: none;
  }

  .detail-status {
    display: flex;
    align-items: center;
    gap: .5rem;
    font-size: .9rem;
    font-weight: 500;
    color: var(--sk-moon);
  }
  .status-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    box-shadow: 0 0 8px currentColor;
  }

  .detail-progress {
    display: flex;
    flex-direction: column;
    gap: .35rem;
  }
  .progress-bar {
    height: 5px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--sk-moon) 15%, transparent);
    overflow: hidden;
  }
  .progress-fill {
    display: block;
    height: 100%;
    border-radius: 999px;
    background: linear-gradient(90deg, var(--sk-comet), var(--sk-river));
  }
  .progress-text {
    font-size: .74rem;
    color: color-mix(in srgb, var(--sk-moon) 55%, transparent);
  }

  .detail-weread-btn {
    display: inline-flex;
    align-items: center;
    gap: .4rem;
    padding: .5rem .85rem;
    border-radius: 999px;
    font-size: .78rem;
    color: color-mix(in srgb, var(--sk-moon) 68%, transparent);
    border: 1px solid color-mix(in srgb, var(--sk-moon) 18%, transparent);
    text-decoration: none;
    transition: all .3s var(--sk-ease-out);
    width: fit-content;
  }
  .detail-weread-btn:hover {
    color: var(--sk-moon);
    border-color: color-mix(in srgb, var(--sk-river) 45%, transparent);
    background: color-mix(in srgb, var(--sk-river) 8%, transparent);
  }

  /* 右栏 */
  .detail-main {
    min-width: 0;
    display: contents;
  }

  .detail-breadcrumb {
    margin-bottom: -.5rem;
    grid-column: 2;
  }
  .detail-breadcrumb a {
    font-size: .82rem;
    color: color-mix(in srgb, var(--sk-comet) 85%, transparent);
    text-decoration: none;
    transition: color .3s;
  }
  .detail-breadcrumb a:hover { color: var(--sk-comet); }

  .detail-header {
    display: flex;
    flex-direction: column;
    gap: .5rem;
    grid-column: 2;
  }

  .detail-title {
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 700;
    color: var(--sk-moon);
    margin: 0;
    line-height: 1.25;
    letter-spacing: .03em;
  }
  .detail-author {
    font-size: .95rem;
    color: color-mix(in srgb, var(--sk-moon) 64%, transparent);
    margin: 0;
  }
  .detail-translator {
    color: color-mix(in srgb, var(--sk-moon) 48%, transparent);
  }

  .detail-meta-line {
    display: flex;
    flex-wrap: wrap;
    gap: .4rem;
    margin-top: .2rem;
  }
  .meta-chip {
    padding: .15rem .55rem;
    border-radius: 999px;
    font-size: .72rem;
    color: color-mix(in srgb, var(--sk-moon) 60%, transparent);
    background: color-mix(in srgb, var(--sk-moon) 8%, transparent);
    border: 1px solid color-mix(in srgb, var(--sk-moon) 12%, transparent);
  }

  /* 评分 */
  .detail-rating {
    display: flex;
    align-items: center;
    gap: .5rem;
    margin-top: .3rem;
  }
  .rating-stars {
    display: flex;
    gap: 2px;
    color: var(--sk-gold);
  }
  .rating-num {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--sk-gold);
    font-family: var(--sk-font-display);
  }
  .rating-count {
    font-size: .76rem;
    color: color-mix(in srgb, var(--sk-moon) 48%, transparent);
  }

  /* 个人数据 */
  .detail-stats {
    display: flex;
    gap: 1.6rem;
    flex-wrap: wrap;
    padding: 1rem 1.2rem;
    border-radius: 14px;
    background: color-mix(in srgb, var(--sk-moon) 5%, transparent);
    border: 1px solid color-mix(in srgb, var(--sk-moon) 10%, transparent);
    grid-column: 2;
  }
  .dstat {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: .1rem;
  }
  .dstat-num {
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--sk-moon);
    font-family: var(--sk-font-display);
    line-height: 1;
  }
  .dstat-label {
    font-size: .72rem;
    color: color-mix(in srgb, var(--sk-moon) 52%, transparent);
  }

  /* 简介 */
  .detail-section {
    display: flex;
    flex-direction: column;
    gap: .8rem;
  }
  .detail-section--intro,
  .detail-section--notes,
  .detail-section--related {
    grid-column: 1 / -1;
  }
  .section-title {
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--sk-moon);
    margin: 0;
    display: flex;
    align-items: baseline;
    gap: .5rem;
    letter-spacing: .03em;
  }
  .section-count {
    font-size: .76rem;
    font-weight: 400;
    color: color-mix(in srgb, var(--sk-moon) 48%, transparent);
  }

  .detail-section--notes {
    margin-top: .6rem;
    padding: 1.1rem;
    border-radius: 14px;
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--sk-river) 10%, transparent),
      color-mix(in srgb, var(--sk-moon) 4%, transparent)
    );
    border: 1px solid color-mix(in srgb, var(--sk-river) 18%, transparent);
  }
  .notes-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0 .2rem .45rem;
    border-bottom: 1px solid color-mix(in srgb, var(--sk-moon) 10%, transparent);
  }
  .notes-toggle {
    flex: 0 0 auto;
    border: 1px solid color-mix(in srgb, var(--sk-river) 24%, transparent);
    border-radius: 999px;
    padding: .32rem .72rem;
    font-size: .74rem;
    color: color-mix(in srgb, var(--sk-moon) 72%, transparent);
    background: color-mix(in srgb, var(--sk-night) 62%, transparent);
    cursor: pointer;
    transition: color .25s, border-color .25s, background .25s;
  }
  .notes-toggle:hover {
    color: var(--sk-moon);
    border-color: color-mix(in srgb, var(--sk-comet) 50%, transparent);
    background: color-mix(in srgb, var(--sk-river) 12%, var(--sk-night));
  }

  .detail-intro {
    font-size: .9rem;
    line-height: 1.78;
    color: color-mix(in srgb, var(--sk-moon) 78%, transparent);
    max-width: 68ch;
  }
  .detail-intro p {
    margin: 0 0 .8rem;
    text-indent: 2em;
  }
  .detail-intro p:last-child { margin-bottom: 0; }

  @media (min-width: 960px) {
    .detail-intro {
      columns: 2 24rem;
      column-gap: 2rem;
      column-rule: 1px solid color-mix(in srgb, var(--sk-moon) 10%, transparent);
      max-width: none;
    }
    .detail-intro p {
      break-inside: avoid;
    }
  }

  /* 笔记列表 */
  .notes-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 24rem), 1fr));
    gap: .9rem;
  }
  .note-item {
    margin: 0;
    padding: 1rem 1.1rem;
    border-left: 2px solid color-mix(in srgb, var(--sk-comet) 38%, transparent);
    border-radius: 8px;
    background: color-mix(in srgb, var(--sk-night) 58%, transparent);
    transition: border-color .3s, background .3s, transform .3s var(--sk-ease-out);
  }
  .note-item:hover {
    border-left-color: var(--sk-comet);
    background: color-mix(in srgb, var(--sk-river) 10%, var(--sk-night));
    transform: translateY(-2px);
  }
  .note-text {
    font-size: .92rem;
    line-height: 1.75;
    color: color-mix(in srgb, var(--sk-moon) 88%, transparent);
    margin: 0;
  }
  .note-chapter {
    font-size: .74rem;
    color: color-mix(in srgb, var(--sk-moon) 48%, transparent);
    margin-top: .5rem;
  }
  .is-note-extra {
    display: none;
  }
  .detail-section--notes.is-expanded .is-note-extra {
    display: block;
  }
  .notes-empty {
    padding: .9rem 1rem;
    border-radius: 8px;
    background: color-mix(in srgb, var(--sk-night) 52%, transparent);
    color: color-mix(in srgb, var(--sk-moon) 58%, transparent);
    font-size: .84rem;
    line-height: 1.6;
  }
  .notes-empty p {
    margin: 0;
  }
  .notes-empty-title {
    color: color-mix(in srgb, var(--sk-moon) 82%, transparent);
    font-size: .94rem;
    font-weight: 600;
    margin-bottom: .25rem !important;
  }

  /* 同类书籍 */
  .detail-section--related {
    max-width: 760px;
  }
  .related-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(90px, 116px));
    gap: .7rem;
  }
  .related-card {
    display: flex;
    flex-direction: column;
    gap: .35rem;
    text-decoration: none;
    transition: transform .3s var(--sk-ease-out);
  }
  .related-card:hover { transform: translateY(-4px); }
  .related-cover {
    border-radius: 6px;
    overflow: hidden;
    aspect-ratio: 3 / 4.2;
    background: color-mix(in srgb, var(--sk-tide) 50%, transparent);
    box-shadow: 0 3px 10px rgba(20, 40, 80, 0.14);
  }
  .related-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .related-title {
    font-size: .68rem;
    color: color-mix(in srgb, var(--sk-moon) 72%, transparent);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    line-height: 1.35;
  }

  /* 响应式 */
  @media (max-width: 700px) {
    .detail {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
    .detail-side {
      position: static;
      grid-column: 1;
      grid-row: auto;
      flex-direction: row;
      flex-wrap: wrap;
      align-items: flex-start;
      gap: 1rem;
    }
    .detail-breadcrumb,
    .detail-header,
    .detail-stats,
    .detail-section--intro,
    .detail-section--notes,
    .detail-section--related {
      grid-column: 1;
    }
    .detail-cover { max-width: 140px; }
    .detail-weread-btn { width: 100%; justify-content: center; }
    .related-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: .55rem;
    }
  }
</style>

<script>
  function bindBookBack() {
    const link = document.querySelector<HTMLAnchorElement>('.detail-breadcrumb a[href="/book/"]');
    if (!link || link.dataset.boundBookBack) return;
    link.dataset.boundBookBack = "1";
    link.addEventListener("click", (event) => {
      const state = sessionStorage.getItem("book-shelf-state");
      if (!state) return;
      event.preventDefault();
      window.location.href = `${link.href}#restore-shelf`;
    });
  }

  function bindNotesToggle() {
    const sections = document.querySelectorAll<HTMLElement>("[data-notes-section]");
    for (const section of sections) {
      if (section.dataset.notesBound) continue;
      section.dataset.notesBound = "1";

      const toggle = section.querySelector<HTMLButtonElement>("[data-notes-toggle]");
      if (!toggle) continue;

      toggle.addEventListener("click", () => {
        const expanded = section.classList.toggle("is-expanded");
        toggle.setAttribute("aria-expanded", String(expanded));
        toggle.textContent = expanded ? "收起" : "查看全部";
      });
    }
  }

  bindBookBack();
  bindNotesToggle();
  document.addEventListener("swup:page:view", bindBookBack);
  document.addEventListener("swup:page:view", bindNotesToggle);
</script>
