---
import type { ReadingStats } from "@/types/weread";

interface Props {
	stats: ReadingStats;
}
const { stats } = Astro.props;

const fmtHours = (sec: number) => {
	const h = Math.round(sec / 3600);
	return h > 0 ? `${h}h` : `${Math.round(sec / 60)}m`;
};

// 偏好分类：算占比（用于条形）
const maxCatTime = Math.max(...stats.preferCategory.map((c) => c.time), 1);
const catColors = [
	"linear-gradient(90deg, var(--sk-river), var(--sk-comet))",
	"linear-gradient(90deg, var(--sk-violet), var(--sk-river))",
	"linear-gradient(90deg, var(--sk-comet), var(--sk-sakura))",
	"linear-gradient(90deg, var(--sk-sakura), var(--sk-gold))",
	"linear-gradient(90deg, var(--sk-gold), var(--sk-sunset))",
];
---

<section class="taste sk-rise" data-delay="4">
  <!-- 偏好分类 -->
  <div class="taste-card sk-glass">
    <div class="taste-head">
      <div class="title-wrap">
        <span class="icon-dot"></span>
        <h3 class="taste-title sk-han">读得最多的领域</h3>
      </div>
      {stats.preferCategoryWord && <span class="taste-word">{stats.preferCategoryWord}</span>}
    </div>
    <div class="cat-list">
      {stats.preferCategory.slice(0, 5).map((c, i) => (
        <div class="cat-row">
          <span class="cat-name sk-han">{c.title}</span>
          <div class="cat-bar">
            <span
              class="cat-bar-fill"
              style={`width:${Math.max(8, (c.time / maxCatTime) * 100)}%; background:${catColors[i % catColors.length]}`}
            ></span>
          </div>
          <span class="cat-meta">{c.count}本 · {fmtHours(c.time)}</span>
        </div>
      ))}
    </div>
  </div>

  <!-- 偏好作者 -->
  <div class="taste-card sk-glass">
    <div class="taste-head">
      <div class="title-wrap">
        <span class="icon-dot icon-dot--gold"></span>
        <h3 class="taste-title sk-han">钟爱的作者</h3>
      </div>
      {stats.preferTimeWord && <span class="taste-word">{stats.preferTimeWord}</span>}
    </div>
    <ul class="author-list">
      {stats.preferAuthor.slice(0, 5).map((a, i) => (
        <li class="author-row">
          <span class="author-rank sk-display">{String(i + 1).padStart(2, "0")}</span>
          <span class="author-name sk-han">{a.name}</span>
          <span class="author-meta">{a.count}本 · {a.readTime}</span>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .taste {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.4rem;
    margin: 1.4rem 0;
  }
  @media (max-width: 720px) {
    .taste { grid-template-columns: 1fr; }
  }

  .taste-card {
    padding: 1.6rem 1.8rem;
    border-radius: 24px;
    background: var(--bk-mat-thick-bg);
    backdrop-filter: var(--bk-mat-thick-blur);
    -webkit-backdrop-filter: var(--bk-mat-thick-blur);
    border: 1px solid var(--bk-mat-thick-border);
    box-shadow: var(--bk-mat-thick-shadow), var(--bk-mat-thick-highlight);
  }
  .taste-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: .6rem;
    margin-bottom: 1.3rem;
    flex-wrap: wrap;
  }
  .title-wrap {
    display: flex;
    align-items: center;
    gap: .55rem;
  }
  .icon-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--sk-river);
    box-shadow: 0 0 10px var(--sk-river);
  }
  .icon-dot--gold {
    background: var(--sk-gold);
    box-shadow: 0 0 10px var(--sk-gold);
  }
  .taste-title {
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--sk-moon);
    margin: 0;
    letter-spacing: var(--bk-tracking-title);
    line-height: var(--bk-leading-title);
  }
  .taste-word {
    font-size: .76rem;
    color: var(--sk-comet);
    padding: .2rem .65rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--sk-comet) 14%, transparent);
    border: 1px solid color-mix(in srgb, var(--sk-comet) 28%, transparent);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.08);
    white-space: nowrap;
    font-weight: 500;
    letter-spacing: var(--bk-tracking-caption);
  }

  /* 分类条形 */
  .cat-list { display: flex; flex-direction: column; gap: .9rem; }
  .cat-row {
    display: grid;
    grid-template-columns: 4.8em 1fr auto;
    align-items: center;
    gap: .8rem;
  }
  .cat-name {
    font-size: .88rem;
    color: color-mix(in srgb, var(--sk-moon) 88%, transparent);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    font-weight: 500;
    letter-spacing: var(--bk-tracking-caption);
  }
  .cat-bar {
    height: 8px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--sk-moon) 10%, transparent);
    overflow: hidden;
    box-shadow: inset 0 1px 2px rgba(0, 0, 0, 0.15);
  }
  .cat-bar-fill {
    display: block;
    height: 100%;
    border-radius: 999px;
    transform-origin: left;
    animation: bar-grow .9s var(--bk-ease-out-soft) both;
    box-shadow:
      0 0 12px color-mix(in srgb, var(--sk-river) 40%, transparent),
      inset 0 1px 0 rgba(255, 255, 255, 0.25);
  }
  .cat-row:nth-child(2) .cat-bar-fill { animation-delay: .08s; }
  .cat-row:nth-child(3) .cat-bar-fill { animation-delay: .16s; }
  .cat-row:nth-child(4) .cat-bar-fill { animation-delay: .24s; }
  .cat-row:nth-child(5) .cat-bar-fill { animation-delay: .32s; }
  @keyframes bar-grow { from { transform: scaleX(0); } to { transform: scaleX(1); } }
  .cat-meta {
    font-size: .74rem;
    color: color-mix(in srgb, var(--sk-moon) 58%, transparent);
    font-family: var(--sk-font-display);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    letter-spacing: var(--bk-tracking-caption);
  }

  /* 作者榜 */
  .author-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: .6rem; }
  .author-row {
    display: flex;
    align-items: center;
    gap: .8rem;
    padding: .4rem .6rem;
    border-radius: 12px;
    transition:
      background .25s var(--bk-ease-out-soft),
      transform var(--bk-press-duration) ease-out;
  }
  .author-row:hover {
    background: var(--bk-mat-thin-bg);
  }
  .author-row:active {
    transform: scale(0.985);
  }
  .author-rank {
    font-size: 1.05rem;
    color: color-mix(in srgb, var(--sk-gold) 88%, transparent);
    font-weight: 700;
    min-width: 1.8em;
    font-variant-numeric: tabular-nums;
    letter-spacing: var(--bk-tracking-title);
  }
  .author-name {
    font-size: .92rem;
    color: var(--sk-moon);
    font-weight: 600;
    letter-spacing: var(--bk-tracking-caption);
  }
  .author-meta {
    margin-left: auto;
    font-size: .74rem;
    color: color-mix(in srgb, var(--sk-moon) 58%, transparent);
    font-family: var(--sk-font-display);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    letter-spacing: var(--bk-tracking-caption);
  }
</style>
