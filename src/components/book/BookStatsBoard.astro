---
import type { ReadingStats } from "@/types/weread";

interface Props {
  stats: ReadingStats;
}
const { stats } = Astro.props;

const fmtHours = (sec: number) => {
  const h = Math.round(sec / 3600);
  return h > 0 ? `${h}h` : `${Math.round(sec / 60)}m`;
};

// 偏好分类：算占比（用于条形）
const maxCatTime = Math.max(...stats.preferCategory.map(c => c.time), 1);
const catColors = ["var(--sk-river)", "var(--sk-violet)", "var(--sk-comet)", "var(--sk-sakura)", "var(--sk-gold)", "var(--sk-sunset)"];
---

<section class="taste sk-rise" data-delay="4">
  <!-- 偏好分类 -->
  <div class="taste-card sk-glass">
    <div class="taste-head">
      <h3 class="taste-title sk-han">读得最多的领域</h3>
      {stats.preferCategoryWord && <span class="taste-word">{stats.preferCategoryWord}</span>}
    </div>
    <div class="cat-list">
      {stats.preferCategory.slice(0, 5).map((c, i) => (
        <div class="cat-row">
          <span class="cat-name sk-han">{c.title}</span>
          <div class="cat-bar">
            <span class="cat-bar-fill" style={`width:${Math.max(8, (c.time / maxCatTime) * 100)}%; background:${catColors[i % catColors.length]}`}></span>
          </div>
          <span class="cat-meta">{c.count}本 · {fmtHours(c.time)}</span>
        </div>
      ))}
    </div>
  </div>

  <!-- 偏好作者 -->
  <div class="taste-card sk-glass">
    <div class="taste-head">
      <h3 class="taste-title sk-han">钟爱的作者</h3>
      {stats.preferTimeWord && <span class="taste-word">{stats.preferTimeWord}</span>}
    </div>
    <ul class="author-list">
      {stats.preferAuthor.slice(0, 5).map((a, i) => (
        <li class="author-row">
          <span class="author-rank sk-display">{String(i + 1).padStart(2, "0")}</span>
          <span class="author-name sk-han">{a.name}</span>
          <span class="author-meta">{a.count}本 · {a.readTime}</span>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .taste {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.3rem;
    margin: 1.3rem 0;
  }
  @media (max-width: 720px) {
    .taste { grid-template-columns: 1fr; }
  }

  .taste-card { padding: 1.5rem 1.6rem; }
  .taste-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: .6rem;
    margin-bottom: 1.2rem;
    flex-wrap: wrap;
  }
  .taste-title {
    font-size: 1.12rem;
    font-weight: 600;
    color: var(--sk-moon);
    margin: 0;
  }
  .taste-word {
    font-size: .74rem;
    color: var(--sk-comet);
    padding: .12rem .55rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--sk-comet) 14%, transparent);
    border: 1px solid color-mix(in srgb, var(--sk-comet) 28%, transparent);
    white-space: nowrap;
  }

  /* 分类条形 */
  .cat-list { display: flex; flex-direction: column; gap: .85rem; }
  .cat-row {
    display: grid;
    grid-template-columns: 4.5em 1fr auto;
    align-items: center;
    gap: .7rem;
  }
  .cat-name {
    font-size: .85rem;
    color: color-mix(in srgb, var(--sk-moon) 82%, transparent);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .cat-bar {
    height: 7px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--sk-moon) 10%, transparent);
    overflow: hidden;
  }
  .cat-bar-fill {
    display: block;
    height: 100%;
    border-radius: 999px;
    transform-origin: left;
    animation: bar-grow 1s var(--sk-ease-out) both;
    box-shadow: 0 0 10px color-mix(in srgb, currentColor 40%, transparent);
  }
  @keyframes bar-grow { from { transform: scaleX(0); } to { transform: scaleX(1); } }
  .cat-meta {
    font-size: .72rem;
    color: color-mix(in srgb, var(--sk-moon) 52%, transparent);
    font-family: var(--sk-font-display);
    white-space: nowrap;
  }

  /* 作者榜 */
  .author-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: .7rem; }
  .author-row {
    display: flex;
    align-items: baseline;
    gap: .7rem;
  }
  .author-rank {
    font-size: 1rem;
    color: color-mix(in srgb, var(--sk-gold) 75%, transparent);
    font-weight: 600;
    min-width: 1.8em;
  }
  .author-name {
    font-size: .9rem;
    color: var(--sk-moon);
    font-weight: 500;
  }
  .author-meta {
    margin-left: auto;
    font-size: .72rem;
    color: color-mix(in srgb, var(--sk-moon) 52%, transparent);
    font-family: var(--sk-font-display);
    white-space: nowrap;
  }
</style>
