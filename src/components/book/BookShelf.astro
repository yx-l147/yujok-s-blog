---
import { topCategories } from "@/data/shelf";
import type { BookItem } from "@/types/weread";
import BookCard from "./BookCard.astro";

interface Props {
	books: BookItem[];
}
const { books } = Astro.props;

// ── 状态统计 ──
const counts: Record<string, number> = { all: books.length };
for (const b of books) counts[b.status] = (counts[b.status] ?? 0) + 1;
const reviewedCount = books.filter((b) => b.localReview).length;

// ── 精选：在读 + 读完 + 高评分想读，按价值排序 ──
function score(b: BookItem) {
	let s = 0;
	if (b.status === "reading") s += 5000 + b.progress * 10;
	if (b.status === "finished") s += 4000;
	s += (b.noteCount ?? 0) + (b.bookmarkCount ?? 0);
	s += (b.publicRating ?? 0) * 20;
	s += (b.readUpdateTime ?? 0) / 1e9;
	return s;
}
const featured = [...books]
	.filter((b) => b.status !== "wishlist" || (b.publicRating ?? 0) >= 8.5)
	.sort((a, b) => score(b) - score(a))
	.slice(0, 24);

// ── 全部书籍按最近阅读排序 ──
const allSorted = [...books].sort(
	(a, b) => (b.readUpdateTime ?? 0) - (a.readUpdateTime ?? 0),
);

// ── Tab 定义 ──
const tabs = [
	{ id: "featured", label: "精选", count: featured.length },
	{ id: "reviewed", label: "有书评", count: reviewedCount },
	{ id: "reading", label: "在读", count: counts.reading ?? 0 },
	{ id: "finished", label: "读完", count: counts.finished ?? 0 },
	{ id: "wishlist", label: "想读", count: counts.wishlist ?? 0 },
	{ id: "all", label: "全部", count: counts.all ?? 0 },
] as const;

// ── 分类标签（顶级分类，≥5 本） ──
const cats = topCategories(books, 5);
---

<section class="shelf" data-shelf>
  <!-- ══════ 头部 ══════ -->
  <header class="shelf-head sk-rise" data-delay="2">
    <div class="shelf-titles">
      <p class="shelf-eyebrow sk-script">the shelf</p>
      <h2 class="shelf-title sk-han">书架</h2>
    </div>
  </header>

  <!-- ══════ 筛选栏（Apple Segmented Control + Sliding Thumb） ══════ -->
  <div class="shelf-filters sk-rise" data-delay="2">
    <!-- 状态 Tab -->
    <div class="seg seg--status" role="tablist" aria-label="阅读状态">
      <span class="seg-thumb" aria-hidden="true"></span>
      {tabs.map((t) => (
        <button
          type="button"
          role="tab"
          class:list={["seg-btn seg-btn--status", { "is-active": t.id === "featured" }]}
          data-filter="status"
          data-value={t.id}
          aria-selected={t.id === "featured"}
        >
          <span class="seg-label">{t.label}</span><span class="seg-n">{t.count}</span>
        </button>
      ))}
    </div>

    <!-- 分类 Tag（精选模式下隐藏） -->
    <div class="seg seg--cats" role="tablist" aria-label="书籍分类">
      <span class="seg-thumb" aria-hidden="true"></span>
      <button
        type="button"
        role="tab"
        class="seg-btn seg-btn--cat is-active"
        data-filter="cat"
        data-value="all"
        aria-selected="true"
      >
        <span class="seg-label">全部</span><span class="seg-n">{books.length}</span>
      </button>
      {cats.map((c) => (
        <button
          type="button"
          role="tab"
          class="seg-btn seg-btn--cat"
          data-filter="cat"
          data-value={c.name}
        >
          <span class="seg-label">{c.name}</span><span class="seg-n">{c.count}</span>
        </button>
      ))}
    </div>
  </div>

  <!-- ══════ 精选视图 ══════ -->
  <div class="shelf-grid sk-rise" data-delay="3" data-view="featured">
    {featured.map((book, i) => (
      <BookCard book={book} delay={Math.min(i + 1, 8)} />
    ))}
  </div>

  <!-- ══════ 全部/筛选视图 ══════ -->
  <div class="shelf-grid is-hidden" data-view="all">
    {allSorted.map((book, i) => (
      <div
        class="shelf-cell"
        data-status={book.status}
        data-cat={(book.category || "未分类").split("-")[0]}
        data-reviewed={book.localReview ? "true" : "false"}
      >
        <BookCard book={book} delay={Math.min((i % 8) + 1, 8)} />
      </div>
    ))}
  </div>

  <!-- ══════ 空状态 ══════ -->
  <div class="shelf-empty is-hidden">
    <p class="sk-han">这一格还空着</p>
    <p class="shelf-empty-sub">换个筛选条件试试喵～</p>
  </div>
</section>

<style>
  .shelf { margin: 3.5rem 0 1rem; }

  /* ── 头部 ── */
  .shelf-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem 1.5rem;
    margin-bottom: 1.4rem;
  }
  .shelf-titles { display: flex; align-items: baseline; gap: .8rem; }
  .shelf-eyebrow {
    font-size: 1.5rem;
    color: color-mix(in srgb, var(--sk-comet) 85%, transparent);
    line-height: 1;
    margin: 0;
    letter-spacing: var(--bk-tracking-caption);
  }
  .shelf-title {
    font-size: 1.8rem;
    font-weight: 700;
    color: var(--sk-moon);
    margin: 0;
    line-height: var(--bk-leading-title);
    letter-spacing: var(--bk-tracking-title);
  }

  /* ── Apple Segmented Control（HIG：分段控件，滑动 thumb 指示选中） ── */
  .shelf-filters {
    display: flex;
    flex-direction: column;
    gap: .8rem;
    margin-bottom: 1.8rem;
  }
  .seg {
    position: relative;
    display: flex;
    flex-wrap: nowrap;
    overflow-x: auto;
    overflow-y: hidden;
    scrollbar-width: none;
    -ms-overflow-style: none;
    gap: 2px;
    padding: 3px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--sk-moon) 6%, transparent);
    border: 1px solid color-mix(in srgb, var(--sk-moon) 10%, transparent);
    backdrop-filter: blur(16px) saturate(160%);
    -webkit-backdrop-filter: blur(16px) saturate(160%);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.06);
    max-width: 100%;
    width: fit-content;
  }
  .seg::-webkit-scrollbar { display: none; }
  .seg--cats {
    transition: opacity .35s var(--bk-ease-out-soft);
  }
  .seg--cats.is-dimmed {
    opacity: .32;
    pointer-events: none;
  }

  /* 滑动指示器 — 从当前 transform 出发，从不瞬移（WWDC18 §3 可中断）
     初次渲染先禁用 transition，等 is-ready 后再启用，避免从 (0,0) 飞入 */
  .seg-thumb {
    position: absolute;
    top: 0;
    left: 0;
    height: 0;
    width: 0;
    border-radius: 999px;
    background: linear-gradient(
      135deg,
      color-mix(in srgb, var(--sk-river) 70%, transparent),
      color-mix(in srgb, var(--sk-violet) 55%, transparent)
    );
    box-shadow:
      0 4px 18px color-mix(in srgb, var(--sk-river) 40%, transparent),
      inset 0 1px 0 rgba(255, 255, 255, 0.22);
    transform: translateX(0);
    opacity: 0;
    transition: none;
    pointer-events: none;
    will-change: transform, width;
    z-index: 0;
  }
  .seg.is-ready .seg-thumb {
    transition:
      transform .42s var(--bk-spring),
      width .42s var(--bk-spring),
      opacity .25s var(--bk-ease-out-soft);
  }
  .seg--cats .seg-thumb {
    background: linear-gradient(
      135deg,
      color-mix(in srgb, var(--sk-comet) 62%, transparent),
      color-mix(in srgb, var(--sk-river) 50%, transparent)
    );
    box-shadow:
      0 4px 18px color-mix(in srgb, var(--sk-comet) 35%, transparent),
      inset 0 1px 0 rgba(255, 255, 255, 0.22);
  }

  .seg-btn {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
    gap: .4rem;
    padding: .45rem 1rem;
    border-radius: 999px;
    font-size: .84rem;
    font-weight: 500;
    color: color-mix(in srgb, var(--sk-moon) 72%, transparent);
    background: transparent;
    border: none;
    cursor: pointer;
    font-family: var(--sk-font-han);
    white-space: nowrap;
    letter-spacing: var(--bk-tracking-caption);
    transition:
      color .25s var(--bk-ease-out-soft),
      transform var(--bk-press-duration) ease-out;
    -webkit-tap-highlight-color: transparent;
  }
  .seg-btn:hover { color: var(--sk-moon); }
  .seg-btn:active { transform: scale(var(--bk-press-scale)); }
  .seg-btn.is-active {
    color: #fff;
    font-weight: 600;
  }

  .seg-btn--cat {
    font-size: .78rem;
    padding: .35rem .8rem;
    font-weight: 400;
  }
  .seg-btn--cat.is-active { font-weight: 600; }

  .seg-n {
    font-size: .7rem;
    opacity: .85;
    font-family: var(--sk-font-display);
    font-weight: 600;
    padding: 0 .35rem;
    border-radius: 999px;
    background: rgba(0, 0, 0, 0.18);
    font-variant-numeric: tabular-nums;
    letter-spacing: 0;
  }

  /* ── 网格 ── */
  .shelf-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
    gap: 1.8rem 1.4rem;
  }
  @media (min-width: 768px) {
    .shelf-grid { grid-template-columns: repeat(auto-fill, minmax(175px, 1fr)); }
  }
  @media (max-width: 480px) {
    .shelf-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.3rem 1.0rem;
    }
  }

  /* ── 可见性控制 ── */
  .is-hidden { display: none !important; }

  /* ── 空状态 ── */
  .shelf-empty {
    padding: 4rem 1rem;
    text-align: center;
    color: color-mix(in srgb, var(--sk-moon) 50%, transparent);
    font-size: 1.05rem;
  }
  .shelf-empty-sub {
    font-size: .82rem;
    color: color-mix(in srgb, var(--sk-moon) 40%, transparent);
    margin: .4rem 0 0;
    letter-spacing: var(--bk-tracking-caption);
  }
</style>

<script>
  function bindShelf() {
    for (const shelf of document.querySelectorAll<HTMLElement>("[data-shelf]")) {
      if (shelf.dataset.jsBound !== undefined) continue;
      shelf.dataset.jsBound = "1";

      const statusSeg = shelf.querySelector<HTMLElement>(".seg--status")!;
      const catSeg = shelf.querySelector<HTMLElement>(".seg--cats")!;
      const statusBtns = shelf.querySelectorAll<HTMLButtonElement>("[data-filter=status]");
      const catBtns = shelf.querySelectorAll<HTMLButtonElement>("[data-filter=cat]");
      const featuredView = shelf.querySelector<HTMLElement>('[data-view="featured"]')!;
      const allView = shelf.querySelector<HTMLElement>('[data-view="all"]')!;
      const empty = shelf.querySelector<HTMLElement>(".shelf-empty")!;
      const cells = allView.querySelectorAll<HTMLElement>(".shelf-cell");

      // 滑动指示器：把 thumb 对齐到当前 active 按钮的位置/宽度
      const layoutThumb = (seg: HTMLElement) => {
        const thumb = seg.querySelector<HTMLElement>(".seg-thumb");
        const active = seg.querySelector<HTMLElement>(".seg-btn.is-active");
        if (!thumb || !active) return;
        const segRect = seg.getBoundingClientRect();
        const btnRect = active.getBoundingClientRect();
        thumb.style.width = `${btnRect.width}px`;
        thumb.style.height = `${btnRect.height}px`;
        thumb.style.top = `${btnRect.top - segRect.top}px`;
        thumb.style.transform = `translateX(${active.offsetLeft}px)`;
        thumb.style.opacity = "1";
      };

      const layoutAll = () => {
        layoutThumb(statusSeg);
        if (!catSeg.classList.contains("is-dimmed")) layoutThumb(catSeg);
      };

      // 初次布局：同步测量（点击时布局已是最终态，后台标签页 rAF 会被节流，不能依赖）
      layoutAll();
      // 等首帧后再允许过渡，避免初次 transform 从 0 飞入（rAF 节流时用 fonts.ready 兜底）
      const markReady = () => {
        statusSeg.classList.add("is-ready");
        catSeg.classList.add("is-ready");
      };
      if (document.visibilityState === "visible") {
        requestAnimationFrame(markReady);
      } else {
        // 后台标签页：rAF 被节流，直接标记（此时尚无动画可看，无视觉跳变）
        markReady();
      }
      if (document.fonts?.ready) {
        document.fonts.ready.then(() => layoutAll()).catch(() => {});
      }
      window.addEventListener("resize", layoutAll, { passive: true });
      // 分类行横向滚动时，thumb 跟随滚动位置
      catSeg.addEventListener("scroll", () => layoutThumb(catSeg), { passive: true });
      statusSeg.addEventListener("scroll", () => layoutThumb(statusSeg), { passive: true });

      let activeStatus = "featured";
      let activeCat = "all";
      const saveState = () => {
        sessionStorage.setItem(
          "book-shelf-state",
          JSON.stringify({
            activeStatus,
            activeCat,
            scrollY: window.scrollY,
          }),
        );
      };

      const apply = () => {
        // 更新状态按钮
        for (const b of statusBtns) {
          const on = b.dataset.value === activeStatus;
          b.classList.toggle("is-active", on);
          b.setAttribute("aria-selected", String(on));
        }
        // 更新分类按钮
        for (const b of catBtns) {
          const on = b.dataset.value === activeCat;
          b.classList.toggle("is-active", on);
          b.setAttribute("aria-selected", String(on));
        }

        // 精选模式：隐藏分类行 + 只显示精选网格
        if (activeStatus === "featured") {
          catSeg.classList.add("is-dimmed");
          featuredView.classList.remove("is-hidden");
          allView.classList.add("is-hidden");
          empty.classList.add("is-hidden");
          layoutThumb(statusSeg);
          saveState();
          return;
        }

        // 列表模式：显示分类行 + 按条件筛选
        catSeg.classList.remove("is-dimmed");
        featuredView.classList.add("is-hidden");
        allView.classList.remove("is-hidden");

        let visible = 0;
        for (const cell of cells) {
          const statusMatch =
            activeStatus === "all" ||
            (activeStatus === "reviewed"
              ? cell.dataset.reviewed === "true"
              : cell.dataset.status === activeStatus);
          const catMatch =
            activeCat === "all" || cell.dataset.cat === activeCat;
          const show = statusMatch && catMatch;
          cell.classList.toggle("is-hidden", !show);
          if (show) visible++;
        }

        empty.classList.toggle("is-hidden", visible > 0);
        // 同步测量：classList.toggle 后布局立即稳定，无需等 rAF（后台标签页 rAF 会被节流）
        layoutAll();
        saveState();
      };

      // 状态按钮点击
      for (const b of statusBtns) {
        b.addEventListener("click", () => {
          activeStatus = b.dataset.value || "featured";
          apply();
        });
      }

      // 分类按钮点击
      for (const b of catBtns) {
        b.addEventListener("click", () => {
          activeCat = b.dataset.value || "all";
          apply();
        });
      }

      shelf.addEventListener("click", () => {
        saveState();
      });

      const restore = () => {
        if (window.location.hash !== "#restore-shelf") return;
        const raw = sessionStorage.getItem("book-shelf-state");
        if (!raw) return;
        try {
          const state = JSON.parse(raw) as {
            activeStatus?: string;
            activeCat?: string;
            scrollY?: number;
          };
          activeStatus = state.activeStatus || activeStatus;
          activeCat = state.activeCat || activeCat;
          apply();
          requestAnimationFrame(() => {
            window.scrollTo({ top: state.scrollY ?? 0, behavior: "auto" });
          });
        } catch {
          sessionStorage.removeItem("book-shelf-state");
        }
      };

      restore();
    }
  }

  bindShelf();
  document.addEventListener("swup:page:view", bindShelf);
</script>
