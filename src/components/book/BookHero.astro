---
import type { ReadingProfile, ReadingStats } from "@/types/weread";

interface Props {
  profile: ReadingProfile;
  stats: ReadingStats;
  subtitle?: string;
}
const { profile, stats, subtitle = "在文字的海里打捞自己" } = Astro.props;

const totalHours = Math.round(stats.totalReadTime / 3600);
const years = stats.registTime
  ? Math.max(1, Math.round((Date.now() / 1000 - stats.registTime) / 86400 / 365 * 10) / 10)
  : null;

const summary = [
  { num: profile.totalBooks, label: "本书在架" },
  { num: totalHours, label: "小时阅读" },
  { num: stats.readDays, label: "天有记录" },
  { num: stats.noteCount, label: "条笔记" },
];
---

<section class="hero sk-glass sk-rise" data-delay="0">
  <div class="hero-glow" aria-hidden="true"></div>

  <div class="hero-body">
    <div class="hero-main">
      <p class="hero-eyebrow sk-script">my reading life</p>
      <h1 class="hero-title sk-han">我 的 书 架</h1>
      <p class="hero-sub">「{subtitle}」</p>

      {years && (
        <p class="hero-note">
          自 {new Date((stats.registTime ?? 0) * 1000).getFullYear()} 年起 · 已读过 {stats.readBooks} 本 · 读完 {stats.finishedBooks} 本
        </p>
      )}
    </div>

    {profile.favBook && (
      <a
        class="hero-fav"
        href={`https://weread.qq.com/`}
        title={`最爱的书：${profile.favBook.title}`}
      >
        <span class="fav-tag sk-script">my favourite</span>
        <div class="fav-cover">
          <img src={profile.favBook.cover} alt={profile.favBook.title} loading="lazy" />
        </div>
        <div class="fav-meta">
          <p class="fav-title sk-han">{profile.favBook.title}</p>
          <p class="fav-author">{profile.favBook.author}</p>
        </div>
      </a>
    )}
  </div>

  <div class="hero-stats">
    {summary.map((s) => (
      <div class="hs" data-count={s.num}>
        <span class="hs-num sk-display">0</span>
        <span class="hs-label">{s.label}</span>
      </div>
    ))}
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding: 2.6rem 2.4rem 1.8rem;
    overflow: hidden;
  }
  .hero-glow {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(60% 70% at 18% 10%, color-mix(in srgb, var(--sk-violet) 24%, transparent), transparent 70%),
      radial-gradient(50% 60% at 90% 90%, color-mix(in srgb, var(--sk-comet) 16%, transparent), transparent 70%);
    pointer-events: none;
    z-index: 0;
  }

  .hero-body {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    flex-wrap: wrap;
  }

  .hero-eyebrow {
    font-size: 1.5rem;
    color: var(--sk-comet);
    margin: 0 0 .1rem;
    text-shadow: 0 0 18px color-mix(in srgb, var(--sk-comet) 45%, transparent);
  }
  .hero-title {
    font-size: clamp(2rem, 4.5vw, 3.1rem);
    font-weight: 700;
    color: var(--sk-moon);
    margin: 0;
    letter-spacing: .12em;
    line-height: 1.05;
  }
  .hero-sub {
    margin: .9rem 0 0;
    font-family: var(--sk-font-han);
    font-size: 1.02rem;
    color: color-mix(in srgb, var(--sk-moon) 68%, transparent);
    letter-spacing: .03em;
  }
  .hero-note {
    margin: .5rem 0 0;
    font-size: .82rem;
    color: color-mix(in srgb, var(--sk-moon) 52%, transparent);
    letter-spacing: .02em;
  }

  /* 最爱的书 */
  .hero-fav {
    display: flex;
    align-items: center;
    gap: .9rem;
    padding: .8rem 1rem .8rem .8rem;
    border-radius: 16px;
    background: color-mix(in srgb, var(--sk-moon) 6%, transparent);
    border: 1px solid color-mix(in srgb, var(--sk-gold) 30%, transparent);
    position: relative;
    transition: transform .4s var(--sk-ease-out), box-shadow .4s var(--sk-ease-out);
    text-decoration: none;
  }
  .hero-fav:hover {
    transform: translateY(-3px);
    box-shadow: 0 14px 30px rgba(20,40,80,.2);
  }
  .fav-tag {
    position: absolute;
    top: -.7rem;
    left: 1rem;
    font-size: 1rem;
    color: var(--sk-gold);
    background: var(--sk-glass-bg);
    padding: 0 .4rem;
  }
  .fav-cover {
    width: 52px;
    aspect-ratio: 3/4.2;
    border-radius: 6px;
    overflow: hidden;
    flex-shrink: 0;
    box-shadow: 0 4px 12px rgba(20,40,80,.28);
  }
  .fav-cover img { width: 100%; height: 100%; object-fit: cover; }
  .fav-title {
    font-size: .92rem;
    font-weight: 600;
    color: var(--sk-moon);
    margin: 0;
    max-width: 150px;
  }
  .fav-author {
    font-size: .74rem;
    color: color-mix(in srgb, var(--sk-moon) 55%, transparent);
    margin: .15rem 0 0;
    max-width: 150px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* 数字摘要 */
  .hero-stats {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
    margin-top: 1.8rem;
    padding-top: 1.5rem;
    border-top: 1px solid color-mix(in srgb, var(--sk-moon) 12%, transparent);
  }
  .hs {
    display: flex;
    flex-direction: column;
    gap: .2rem;
  }
  .hs-num {
    font-size: clamp(1.6rem, 3.5vw, 2.3rem);
    font-weight: 600;
    color: var(--sk-moon);
    line-height: 1;
  }
  .hs-label {
    font-size: .76rem;
    font-family: var(--sk-font-han);
    color: color-mix(in srgb, var(--sk-moon) 58%, transparent);
    letter-spacing: .04em;
  }

  @media (max-width: 640px) {
    .hero { padding: 2rem 1.4rem 1.5rem; }
    .hero-fav { width: 100%; }
    .fav-title, .fav-author { max-width: none; }
    .hero-stats { gap: .8rem; }
  }
</style>

<script>
  function countUp() {
    const els = document.querySelectorAll<HTMLElement>(".hs[data-count] .hs-num");
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) {
        if (!e.isIntersecting) continue;
        const wrap = e.target.closest<HTMLElement>(".hs")!;
        const target = +(wrap.dataset.count ?? "0");
        const numEl = e.target as HTMLElement;
        const dur = 1300;
        const start = performance.now();
        const step = (t: number) => {
          const k = Math.min(1, (t - start) / dur);
          const eased = 1 - (1 - k) ** 3;
          numEl.textContent = Math.round(target * eased).toLocaleString();
          if (k < 1) requestAnimationFrame(step);
        };
        requestAnimationFrame(step);
        io.unobserve(e.target);
      }
    }, { threshold: 0.5 });
    for (const el of els) io.observe(el);
  }
  countUp();
  document.addEventListener("swup:page:view", countUp);
</script>
