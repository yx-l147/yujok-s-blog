---
import StarRiver from "@/components/effects/StarRiver.svelte";
import type { ReadingProfile } from "@/types/weread";

interface Props {
  profile: ReadingProfile;
  subtitle?: string;
}
const { profile, subtitle = "在文字的海里打捞自己" } = Astro.props;

const totalHours = Math.round(profile.totalReadingTime / 3600);
---

<section class="book-hero sk-glass sk-rise" data-delay="0">
  <!-- 流动银河层 -->
  <div class="hero-bg">
    <StarRiver client:only="svelte" density={260} speed={0.22} meteors={true} />
    <div class="hero-gradient"></div>
  </div>

  <div class="hero-content">
    <!-- 左：竖排日文巨字 -->
    <div class="hero-left">
      <div class="vertical-jp" aria-hidden="true">
        <span>書</span>
        <span>棚</span>
      </div>
    </div>

    <!-- 中：标题 -->
    <div class="hero-mid">
      <div class="sk-rule" style="width:64px; margin-bottom:1.2rem;"></div>
      <p class="hero-eyebrow sk-script">bibliotheca</p>
      <h1 class="hero-title sk-display">My&nbsp;Bookshelf</h1>
      <h2 class="hero-han sk-han">书&nbsp;　&nbsp;架</h2>
      <p class="hero-sub">「{subtitle}」</p>
    </div>

    <!-- 右：数字摘要 -->
    <div class="hero-right">
      <div class="hero-mini">
        <div class="mini-num sk-display">{profile.totalFinished}</div>
        <div class="mini-label">累计读完</div>
      </div>
      <div class="hero-mini">
        <div class="mini-num sk-display">{totalHours}</div>
        <div class="mini-label">阅读小时</div>
      </div>
      <div class="hero-mini">
        <div class="mini-num sk-display">{profile.streak}</div>
        <div class="mini-label">连续天数</div>
      </div>
    </div>
  </div>
</section>

<style>
  .book-hero {
    position: relative;
    min-height: 360px;
    padding: 3rem 2.5rem 3rem;
    overflow: hidden;
  }
  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }
  .hero-gradient {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(70% 80% at 30% 20%, color-mix(in srgb, var(--sk-violet) 22%, transparent), transparent 70%),
      radial-gradient(50% 60% at 80% 80%, color-mix(in srgb, var(--sk-sunset) 18%, transparent), transparent 70%),
      linear-gradient(135deg, color-mix(in srgb, var(--sk-tide) 60%, transparent), transparent 60%);
  }

  .hero-content {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 2.5rem;
    align-items: center;
  }

  /* 左：竖排 */
  .vertical-jp {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: .8rem;
    font-family: var(--sk-font-han);
    font-size: 4.5rem;
    font-weight: 600;
    color: color-mix(in srgb, var(--sk-river) 55%, var(--sk-moon));
    line-height: 1;
    letter-spacing: -.05em;
    text-shadow: 0 4px 30px color-mix(in srgb, var(--sk-river) 40%, transparent);
  }

  /* 中 */
  .hero-eyebrow {
    font-size: 1.6rem;
    color: var(--sk-comet);
    margin: 0 0 .2rem;
    letter-spacing: 0.04em;
    text-shadow: 0 0 18px color-mix(in srgb, var(--sk-comet) 50%, transparent);
  }
  .hero-title {
    font-size: clamp(2.5rem, 5.5vw, 4.6rem);
    color: var(--sk-moon);
    margin: 0;
    font-weight: 500;
    line-height: 0.95;
  }
  .hero-han {
    font-size: clamp(1.4rem, 2.5vw, 2rem);
    color: color-mix(in srgb, var(--sk-moon) 80%, transparent);
    margin: .4rem 0 0;
    font-weight: 500;
    letter-spacing: 0.5em;
  }
  .hero-sub {
    margin: 1.2rem 0 0;
    color: color-mix(in srgb, var(--sk-moon) 65%, transparent);
    font-family: var(--sk-font-han);
    font-size: 1rem;
    letter-spacing: 0.04em;
  }

  /* 右 */
  .hero-right {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    text-align: right;
    min-width: 140px;
  }
  .hero-mini {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    padding: .35rem .85rem;
    border-right: 2px solid color-mix(in srgb, var(--sk-gold) 60%, transparent);
  }
  .mini-num {
    font-size: 2.4rem;
    font-weight: 500;
    color: var(--sk-moon);
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .mini-label {
    font-size: .72rem;
    color: color-mix(in srgb, var(--sk-moon) 55%, transparent);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    margin-top: .25rem;
  }

  @media (max-width: 900px) {
    .hero-content {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
    .vertical-jp {
      flex-direction: row;
      font-size: 3rem;
    }
    .hero-right {
      flex-direction: row;
      text-align: left;
    }
    .hero-mini {
      align-items: flex-start;
      border-right: none;
      border-left: 2px solid color-mix(in srgb, var(--sk-gold) 60%, transparent);
      padding: .2rem .85rem;
    }
  }
</style>
