---
interface Props {
	progress: number; // 0-100
	size?: number;
	title?: string;
}
const { progress, size = 40, title } = Astro.props;
const p = Math.max(0, Math.min(100, progress));

// 月相：用一个圆 + 一个椭圆覆盖来生成 8 个相位
// 0%=新月（全黑），50%=半月，100%=满月
const phase = p / 100;
const ellipseRx = (1 - Math.abs(0.5 - phase) * 2) * (size / 2);
const ellipseCx =
	phase < 0.5
		? size / 2 + (size / 4) * (1 - phase * 2)
		: size / 2 - (size / 4) * (phase * 2 - 1);
const isWaxing = phase < 0.5;
---
<div class="inline-flex items-center gap-2" title={title ?? `阅读进度 ${p}%`}>
  <svg width={size} height={size} viewBox={`0 0 ${size} ${size}`} aria-hidden="true">
    <defs>
      <radialGradient id={`moon-${p.toFixed(0)}`} cx="35%" cy="30%" r="80%">
        <stop offset="0%" stop-color="#fff8d8" />
        <stop offset="55%" stop-color="#e8d8a8" />
        <stop offset="100%" stop-color="#9c8a5a" />
      </radialGradient>
    </defs>
    <!-- 黑色底（夜空） -->
    <circle cx={size/2} cy={size/2} r={size/2 - 1} fill="rgba(10,20,40,0.85)" stroke="rgba(180,200,255,0.25)" stroke-width="1" />
    <!-- 亮月 -->
    {phase > 0 && phase < 1 && (
      <>
        <clipPath id={`clip-${p.toFixed(0)}`}>
          <circle cx={size/2} cy={size/2} r={size/2 - 2} />
        </clipPath>
        <g clip-path={`url(#clip-${p.toFixed(0)})`}>
          <circle cx={size/2} cy={size/2} r={size/2 - 2} fill={`url(#moon-${p.toFixed(0)})`} />
          <ellipse cx={ellipseCx} cy={size/2} rx={ellipseRx} ry={size/2 - 2} fill="rgba(10,20,40,0.95)" />
          {isWaxing && (
            <rect x={0} y={0} width={size/2} height={size} fill="rgba(10,20,40,0.95)" />
          )}
          {!isWaxing && (
            <rect x={size/2} y={0} width={size/2} height={size} fill="rgba(10,20,40,0.95)" />
          )}
        </g>
      </>
    )}
    {phase >= 1 && (
      <circle cx={size/2} cy={size/2} r={size/2 - 2} fill={`url(#moon-${p.toFixed(0)})`} />
    )}
  </svg>
  <span class="text-xs font-medium text-[var(--sk-moon)] tabular-nums opacity-80">{p}%</span>
</div>
