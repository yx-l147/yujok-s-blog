---
import type { BookItem } from "@/types/weread";

interface Props {
	book: BookItem;
	delay?: number;
}
const { book, delay = 0 } = Astro.props;

const STATUS_META: Record<
	BookItem["status"],
	{ label: string; color: string }
> = {
	reading: { label: "在读", color: "var(--sk-comet)" },
	finished: { label: "读完", color: "var(--sk-river)" },
	wishlist: { label: "想读", color: "var(--sk-sakura)" },
};
const meta = STATUS_META[book.status];

const hours = book.readTime ? Math.round(book.readTime / 3600) : 0;
const noteTotal = (book.noteCount ?? 0) + (book.bookmarkCount ?? 0);
// 微信读书标签里挑一个最有代表性的
const highlight = book.tags?.[0];
const review = book.localReview;
const verdictLabel = review
	? {
			recommend: "推荐",
			neutral: "中庸",
			avoid: "不行",
		}[review.verdict]
	: null;
---

<a
  href={`/book/${book.bookId}/`}
  class="bk sk-rise"
  data-delay={Math.min(delay, 8)}
  style={`--bk-accent:${meta.color}`}
>
  <div class="bk-cover-wrap">
    <div class="bk-cover">
      <img src={book.cover} alt={book.title} loading="lazy" decoding="async" />
      <div class="bk-cover-sheen" aria-hidden="true"></div>
      <div class="bk-spine" aria-hidden="true"></div>

      <!-- 状态角标 -->
      <span class="bk-badge" style={`--badge:${meta.color}`}>{meta.label}</span>

      <!-- 在读：底部进度条 -->
      {book.status === "reading" && book.progress > 0 && (
        <div class="bk-progress" title={`已读 ${book.progress}%`}>
          <span class="bk-progress-fill" style={`width:${book.progress}%`}></span>
        </div>
      )}

      <!-- 特殊标签 -->
      {highlight && <span class="bk-tag">✦ {highlight}</span>}

      {review && <span class="bk-review-badge">{verdictLabel}</span>}
      {review?.draft && <span class="bk-draft-badge">草稿</span>}
    </div>
  </div>

  <div class="bk-info">
    <h3 class="bk-title sk-han" title={book.title}>{book.title}</h3>
    <p class="bk-author">{book.author}</p>
    {review?.summary && <p class="bk-review sk-han">{review.summary}</p>}

    <div class="bk-foot">
      {book.publicRating && book.publicRating > 0 ? (
        <span class="bk-rating" title={`微信读书评分 ${book.publicRating}`}>
          <svg viewBox="0 0 24 24" width="12" height="12" fill="currentColor" aria-hidden="true">
            <path d="M12 2l2.9 6.9L22 10l-5.5 4.7L18 22l-6-3.6L6 22l1.5-7.3L2 10l7.1-1.1z"/>
          </svg>
          {book.publicRating.toFixed(1)}
        </span>
      ) : (
        <span class="bk-rating bk-rating-empty">—</span>
      )}

      <span class="bk-foot-right">
        {book.status === "finished" && hours > 0 && (
          <span class="bk-metric">{hours}<i>h</i></span>
        )}
        {book.status === "reading" && (
          <span class="bk-metric">{book.progress}<i>%</i></span>
        )}
        {noteTotal > 0 && (
          <span class="bk-metric bk-metric-note" title={`${book.noteCount ?? 0} 笔记 · ${book.bookmarkCount ?? 0} 划线`}>
            {noteTotal}<i>记</i>
          </span>
        )}
        {review && (
          <span class="bk-metric bk-metric-review" title="本地书评">
            评
          </span>
        )}
      </span>
    </div>
  </div>
</a>

<style>
  .bk {
    --bk-accent: var(--sk-river);
    display: flex;
    flex-direction: column;
    cursor: pointer;
    text-decoration: none;
    color: inherit;
    perspective: 1000px;
    transition: transform .5s var(--bk-spring);
    -webkit-tap-highlight-color: transparent;
  }
  /* pointer-down 立即反馈（WWDC18 §1：响应是基础）*/
  .bk:active {
    transform: scale(var(--bk-press-scale));
    transition-duration: var(--bk-press-duration);
  }

  .bk-cover-wrap {
    position: relative;
    border-radius: 14px;
    transform-style: preserve-3d;
    transition: transform .55s var(--bk-spring);
  }
  .bk:hover .bk-cover-wrap {
    transform: translateY(-8px) rotateX(2.5deg) rotateY(-1.5deg);
  }

  /* ── Apple Books Style 封面 ── */
  .bk-cover {
    position: relative;
    aspect-ratio: 3 / 4.35;
    border-radius: 14px;
    overflow: hidden;
    background: color-mix(in srgb, var(--sk-tide) 50%, transparent);
    box-shadow:
      0 10px 25px rgba(0, 0, 0, 0.22),
      0 2px 8px rgba(0, 0, 0, 0.12),
      inset 0 1px 0 rgba(255, 255, 255, 0.15);
    transition: box-shadow .55s var(--bk-spring);
  }
  .bk:hover .bk-cover {
    box-shadow:
      0 26px 50px rgba(0, 0, 0, 0.4),
      0 10px 24px color-mix(in srgb, var(--bk-accent) 35%, transparent),
      inset 0 1px 0 rgba(255, 255, 255, 0.22);
  }
  .bk-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform .8s var(--bk-ease-out-soft);
  }
  .bk:hover .bk-cover img { transform: scale(1.06); }

  /* 左侧书脊模拟 */
  .bk-spine {
    position: absolute;
    top: 0; bottom: 0; left: 0;
    width: 4px;
    background: linear-gradient(90deg, rgba(255, 255, 255, .35) 0%, rgba(0, 0, 0, .2) 100%);
    pointer-events: none;
    z-index: 2;
  }

  /* 斜向扫过高光 */
  .bk-cover-sheen {
    position: absolute;
    inset: 0;
    background: linear-gradient(115deg, transparent 35%, rgba(255, 255, 255, .24) 50%, transparent 65%);
    transform: translateX(-130%);
    transition: transform .9s var(--bk-ease-out-soft);
    pointer-events: none;
    z-index: 3;
  }
  .bk:hover .bk-cover-sheen { transform: translateX(130%); }

  .bk-badge {
    position: absolute;
    top: .6rem;
    left: .6rem;
    padding: .15rem .55rem;
    border-radius: 999px;
    font-size: .7rem;
    font-weight: 600;
    color: #fff;
    background: color-mix(in srgb, var(--badge) 88%, #000);
    box-shadow:
      0 3px 10px color-mix(in srgb, var(--badge) 50%, transparent),
      inset 0 1px 0 rgba(255, 255, 255, 0.25);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    z-index: 4;
    letter-spacing: var(--bk-tracking-caption);
  }

  .bk-tag {
    position: absolute;
    bottom: .55rem;
    left: .55rem;
    right: .55rem;
    padding: .25rem .5rem;
    border-radius: 8px;
    font-size: .68rem;
    font-weight: 500;
    color: #fff;
    background: color-mix(in srgb, var(--sk-gold) 82%, rgba(0, 0, 0, .55));
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    text-align: center;
    letter-spacing: var(--bk-tracking-caption);
    text-shadow: 0 1px 3px rgba(0, 0, 0, .4);
    z-index: 4;
  }

  .bk-review-badge {
    position: absolute;
    top: .6rem;
    right: .6rem;
    padding: .15rem .55rem;
    border-radius: 999px;
    font-size: .7rem;
    font-weight: 600;
    color: var(--sk-night);
    background: color-mix(in srgb, var(--sk-gold) 90%, #fff);
    box-shadow:
      0 3px 10px color-mix(in srgb, var(--sk-gold) 50%, transparent),
      inset 0 1px 0 rgba(255, 255, 255, 0.4);
    z-index: 4;
    letter-spacing: var(--bk-tracking-caption);
  }

  .bk-draft-badge {
    position: absolute;
    top: 2.1rem;
    right: .6rem;
    padding: .15rem .55rem;
    border-radius: 999px;
    font-size: .7rem;
    font-weight: 600;
    color: #fff;
    background: color-mix(in srgb, var(--sk-comet) 80%, #000);
    box-shadow: 0 3px 10px color-mix(in srgb, var(--sk-comet) 45%, transparent);
    z-index: 4;
    letter-spacing: var(--bk-tracking-caption);
  }

  .bk-progress {
    position: absolute;
    bottom: 0; left: 0; right: 0;
    height: 4px;
    background: rgba(0, 0, 0, .35);
    z-index: 4;
  }
  .bk-progress-fill {
    display: block;
    height: 100%;
    background: var(--bk-accent);
    box-shadow: 0 0 12px var(--bk-accent);
  }

  /* ── 信息区 ── */
  .bk-info {
    padding: .75rem .2rem 0;
    display: flex;
    flex-direction: column;
    gap: .18rem;
  }
  .bk-title {
    font-size: .96rem;
    font-weight: 600;
    color: var(--sk-moon);
    line-height: var(--bk-leading-title);
    letter-spacing: var(--bk-tracking-title);
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .bk-author {
    font-size: .8rem;
    color: color-mix(in srgb, var(--sk-moon) 62%, transparent);
    letter-spacing: var(--bk-tracking-caption);
    margin: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .bk-review {
    margin: .3rem 0 0;
    font-size: .78rem;
    line-height: var(--bk-leading-body);
    color: color-mix(in srgb, var(--sk-moon) 72%, transparent);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .bk-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: .4rem;
  }
  .bk-rating {
    display: inline-flex;
    align-items: center;
    gap: .22rem;
    font-size: .8rem;
    font-weight: 600;
    color: var(--sk-gold);
    font-family: var(--sk-font-display);
    font-variant-numeric: tabular-nums;
  }
  .bk-rating svg { opacity: .95; }
  .bk-rating-empty { color: color-mix(in srgb, var(--sk-moon) 30%, transparent); }

  .bk-foot-right {
    display: inline-flex;
    align-items: baseline;
    gap: .55rem;
  }
  .bk-metric {
    font-size: .84rem;
    font-weight: 600;
    color: color-mix(in srgb, var(--sk-moon) 78%, transparent);
    font-family: var(--sk-font-display);
    font-variant-numeric: tabular-nums;
  }
  .bk-metric i {
    font-size: .64rem;
    font-style: normal;
    font-family: var(--sk-font-han);
    color: color-mix(in srgb, var(--sk-moon) 52%, transparent);
    margin-left: .05rem;
  }
  .bk-metric-note { color: color-mix(in srgb, var(--bk-accent) 85%, var(--sk-moon)); }
  .bk-metric-note i { color: color-mix(in srgb, var(--bk-accent) 60%, transparent); }
  .bk-metric-review {
    color: color-mix(in srgb, var(--sk-gold) 90%, var(--sk-moon));
  }
</style>
