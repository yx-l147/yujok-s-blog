---
import { Icon } from "astro-icon/components";
import { navBarConfig, profileConfig, siteConfig } from "../config";
import { LinkPresets } from "../constants/link-presets";
import { LinkPreset, type NavBarLink } from "../types/config";
import { pathsEqual, url } from "../utils/url-utils";
import LightDarkSwitch from "./LightDarkSwitch.svelte";
import Search from "./Search.svelte";
import DisplaySettings from "./widget/DisplaySettings.svelte";
import NavMenuPanel from "./widget/NavMenuPanel.astro";

const className = Astro.props.class;

const links: NavBarLink[] = navBarConfig.links.map(
	(item: NavBarLink | LinkPreset): NavBarLink => {
		if (typeof item === "number") {
			return LinkPresets[item];
		}
		return item;
	},
);
const pinnedLinkUrls = new Set([
	"/",
	"/archive/",
	"/book/",
	"/schedule/",
	"/about/",
	"/thoughts/",
]);
const primaryLinks = links.filter((link) => pinnedLinkUrls.has(link.url));
const moreLinks = links.filter((link) => !pinnedLinkUrls.has(link.url));

const isActive = (link: NavBarLink) => {
	if (link.external) return false;
	return pathsEqual(Astro.url.pathname, url(link.url));
};
const isMoreActive = moreLinks.some((link) => isActive(link));

const navIcon = (link: NavBarLink) => {
	const icons: Record<string, string> = {
		"/": "material-symbols:home-rounded",
		"/archive/": "material-symbols:history-rounded",
		"/book/": "material-symbols:menu-book-rounded",
		"/schedule/": "material-symbols:calendar-month-rounded",
		"/thoughts/": "material-symbols:lightbulb-rounded",
		"/about/": "material-symbols:sentiment-satisfied-rounded",
		"/categories/": "material-symbols:folder-rounded",
		"/tags/": "material-symbols:tag-rounded",
		"/bangumi/": "material-symbols:live-tv-rounded",
	};
	return icons[link.url] || "material-symbols:arrow-outward-rounded";
};
---

<div id="navbar" class="z-50 onload-animation">
    <div class:list={[
        className,
        "nav-shell max-w-[var(--page-width)] h-[4.5rem] mx-auto flex items-center justify-between gap-2 px-3 md:px-4"]}>
        <a href={url("/")} class="nav-brand btn-plain scale-animation rounded-xl h-[3.25rem] px-3 md:px-5 font-black active:scale-95">
            <div class="flex flex-row text-[var(--primary)] items-center text-md">
                <Icon name="material-symbols:home-outline-rounded" class="text-[1.75rem] mb-1 mr-2" />
                <span class="hidden sm:inline">{siteConfig.title}</span>
                <span class="sm:hidden">{profileConfig?.name || "Blog"}</span>
            </div>
        </a>
        <nav class="nav-rail hidden min-w-0 flex-nowrap items-center gap-1 lg:flex" aria-label="Primary navigation">
            {primaryLinks.map((l) => (
                <a aria-label={l.name} href={l.external ? l.url : url(l.url)} target={l.external ? "_blank" : undefined}
                    class:list={[
                        "nav-link btn-plain scale-animation rounded-xl h-11 shrink-0 whitespace-nowrap font-bold px-3 xl:px-4 active:scale-95",
                        {"nav-link-active": isActive(l)}
                    ]}
                >
                    <div class="flex items-center gap-1.5 whitespace-nowrap">
                        <Icon name={navIcon(l)} class="nav-link-icon" />
                        {l.name}
                        {l.external && <Icon name="fa6-solid:arrow-up-right-from-square" class="text-[0.75rem] transition -translate-y-[1px] ml-1 text-black/[0.2] dark:text-white/[0.2]" />}
                    </div>
                </a>
            ))}
        </nav>
        {moreLinks.length > 0 && (
            <details class:list={["nav-more hidden lg:block", { "nav-more-active": isMoreActive }]}>
                <summary class:list={[
                    "nav-link nav-more-trigger btn-plain scale-animation rounded-xl h-11 shrink-0 whitespace-nowrap font-bold px-3 xl:px-4 active:scale-95",
                    { "nav-link-active": isMoreActive },
                ]}>
                    <Icon name="material-symbols:more-horiz" class="nav-link-icon" />
                    <span>更多</span>
                    <Icon name="material-symbols:expand-more-rounded" class="nav-more-chevron text-[1.15rem]" />
                </summary>
                <div class="nav-more-panel">
                    {moreLinks.map((l) => (
                        <a
                            aria-label={l.name}
                            href={l.external ? l.url : url(l.url)}
                            target={l.external ? "_blank" : undefined}
                            rel={l.external ? "noopener" : undefined}
                            class:list={["nav-more-item", { "nav-more-item-active": isActive(l) }]}
                        >
                            <span>{l.name}</span>
                            {l.external
                                ? <Icon name="fa6-solid:arrow-up-right-from-square" class="text-[0.72rem]" />
                                : <Icon name="material-symbols:chevron-right-rounded" class="text-[1.1rem]" />}
                        </a>
                    ))}
                </div>
            </details>
        )}
        <div class="nav-actions flex items-center">
            <Search client:only="svelte" />
            {!siteConfig.themeColor.fixed && (
                    <button aria-label="Display Settings" class="btn-plain scale-animation rounded-lg h-11 w-11 active:scale-90" id="display-settings-switch">
                        <Icon name="material-symbols:palette-outline" class="text-[1.25rem]" />
                    </button>
            )}
            <LightDarkSwitch client:only="svelte" />
            {siteConfig.rightSidebar.enable && (
                <button aria-label="Toggle Right Sidebar" class="hidden xl:inline-flex btn-plain scale-animation rounded-lg h-11 w-11 active:scale-90" id="right-sidebar-switch">
                    <Icon name="material-symbols:right-panel-open-outline-rounded" class="text-[1.25rem]" />
                </button>
            )}
            <button aria-label="Menu" name="Nav Menu" class="btn-plain scale-animation rounded-lg w-11 h-11 active:scale-90 lg:!hidden" id="nav-menu-switch">
                <Icon name="material-symbols:menu-rounded" class="text-[1.25rem]" />
            </button>
        </div>
        <NavMenuPanel links={links} />
        <DisplaySettings client:only="svelte" />
    </div>
</div>

<script>
function switchTheme() {
    if (localStorage.theme === 'dark') {
        document.documentElement.classList.remove('dark');
        localStorage.theme = 'light';
    } else {
        document.documentElement.classList.add('dark');
        localStorage.theme = 'dark';
    }
}

function loadButtonScript() {
    let switchBtn = document.getElementById("scheme-switch");
    if (switchBtn) {
        switchBtn.onclick = function () {
            switchTheme()
        };
    }

    let settingBtn = document.getElementById("display-settings-switch");
    if (settingBtn) {
        settingBtn.onclick = function () {
            let settingPanel = document.getElementById("display-setting");
            if (settingPanel) {
                settingPanel.classList.toggle("float-panel-closed");
            }
        };
    }

    let menuBtn = document.getElementById("nav-menu-switch");
    if (menuBtn) {
        menuBtn.onclick = function () {
            let menuPanel = document.getElementById("nav-menu-panel");
            if (menuPanel) {
                menuPanel.classList.toggle("float-panel-closed");
            }
        };
    }

    let rsBtn = document.getElementById("right-sidebar-switch");
    if (rsBtn) {
        rsBtn.onclick = function () {
            const root = document.documentElement;
            const willCollapse = !root.classList.contains("right-sidebar-collapsed");
            root.classList.toggle("right-sidebar-collapsed", willCollapse);
            localStorage.setItem("right-sidebar-open", String(!willCollapse));
        };
    }
}

loadButtonScript();

// Fix: update nav-link-active after Swup client-side navigation
function updateNavActive() {
    const navLinks = document.querySelectorAll("nav .nav-link");
    const currentPath = window.location.pathname.replace(/^\/|\/$/g, "").toLowerCase();
    navLinks.forEach((link) => {
        const href = (link as HTMLAnchorElement).getAttribute("href") || "";
        const linkPath = href.replace(/^\/|\/$/g, "").toLowerCase();
        if (linkPath === currentPath) {
            link.classList.add("nav-link-active");
        } else {
            link.classList.remove("nav-link-active");
        }
    });

    const more = document.querySelector(".nav-more");
    if (more) {
        const hasActiveChild = Array.from(more.querySelectorAll(".nav-more-item")).some((link) => {
            const href = (link as HTMLAnchorElement).getAttribute("href") || "";
            const linkPath = href.replace(/^\/|\/$/g, "").toLowerCase();
            return linkPath === currentPath;
        });
        more.classList.toggle("nav-more-active", hasActiveChild);
        more.querySelector(".nav-more-trigger")?.classList.toggle("nav-link-active", hasActiveChild);
    }
}
if (window?.swup?.hooks) {
    window.swup.hooks.on("page:view", updateNavActive);
} else {
    document.addEventListener("swup:enable", () => {
        window.swup.hooks.on("page:view", updateNavActive);
    });
}

function bindNavActiveFeedback() {
    const nav = document.querySelector(".nav-rail");
    if (!nav || (nav as HTMLElement).dataset.activeFeedbackBound) return;

    (nav as HTMLElement).dataset.activeFeedbackBound = "true";
    nav.addEventListener("click", (event) => {
        if (!(event instanceof MouseEvent) || event.defaultPrevented || event.button !== 0) return;
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;

        const link = (event.target as Element).closest(".nav-link");
        if (!(link instanceof HTMLAnchorElement)) return;
        if (link.target === "_blank" || link.classList.contains("nav-link-active")) return;

        for (const item of nav.querySelectorAll(".nav-link")) {
            item.classList.toggle("nav-link-active", item === link);
        }
    });
}

bindNavActiveFeedback();
document.addEventListener("astro:page-load", bindNavActiveFeedback);

function bindNavMore() {
    const more = document.querySelector(".nav-more") as HTMLDetailsElement | null;
    if (!more || more.dataset.bound) return;
    more.dataset.bound = "true";

    more.querySelectorAll("a").forEach((link) => {
        link.addEventListener("click", () => {
            more.open = false;
        });
    });

    document.addEventListener("click", (event) => {
        if (!more.open || more.contains(event.target as Node)) return;
        more.open = false;
    });
}

bindNavMore();
document.addEventListener("astro:page-load", bindNavMore);
</script>

{import.meta.env.PROD && <script is:inline define:vars={{scriptUrl: url('/pagefind/pagefind.js')}}>
async function loadPagefind() {
    try {
        const response = await fetch(scriptUrl, { method: 'HEAD' });
        if (!response.ok) {
            throw new Error(`Pagefind script not found: ${response.status}`);
        }

        const pagefind = await import(scriptUrl);

        await pagefind.options({
            excerptLength: 20
        });

        window.pagefind = pagefind;

        document.dispatchEvent(new CustomEvent('pagefindready'));
    } catch (error) {
        console.error('Failed to load Pagefind:', error);
        window.pagefind = {
            search: () => Promise.resolve({ results: [] }),
            options: () => Promise.resolve(),
        };
        document.dispatchEvent(new CustomEvent('pagefindloaderror'));
    }
}

if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', loadPagefind);
} else {
    loadPagefind();
}
</script>}
