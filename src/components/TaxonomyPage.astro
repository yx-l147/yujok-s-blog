---
import { Icon } from "astro-icon/components";
import type { PostForList, TaxonomyItem } from "../utils/content-utils";
import { getPostUrlBySlug } from "../utils/url-utils";

interface Props {
	title: string;
	description: string;
	items?: TaxonomyItem[];
	posts?: PostForList[];
	activeName?: string;
	kind: "categories" | "tags" | "series" | "columns";
}

const { title, description, items = [], posts = [], activeName } = Astro.props;
const hasPosts = posts.length > 0;
---

<section class="card-base glass-panel px-6 md:px-8 py-8 mb-4">
    <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-5 mb-8">
        <div>
            <div class="text-sm font-semibold uppercase tracking-[0.18em] text-[var(--primary)] mb-3">{title}</div>
            <h1 class="text-3xl md:text-4xl font-bold text-90 mb-3">{activeName || title}</h1>
            <p class="text-50 leading-7 max-w-2xl">{description}</p>
        </div>
        <div class="h-12 w-12 rounded-2xl bg-[var(--btn-regular-bg)] text-[var(--primary)] flex items-center justify-center shrink-0">
            <Icon name="material-symbols:folder-special-outline-rounded" class="text-[1.65rem]" />
        </div>
    </div>

    {!activeName && (
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
            {items.length === 0 && <div class="rounded-2xl border border-dashed border-[var(--line-divider)] px-5 py-6 text-50">
                暂时还没有可展示的内容分类。
            </div>}
            {items.map((item) => (
                <a href={item.url} class="taxonomy-tile group">
                    <span class="font-semibold text-75 group-hover:text-[var(--primary)] transition overflow-hidden text-ellipsis whitespace-nowrap">{item.name}</span>
                    <span class="taxonomy-count">{item.count}</span>
                </a>
            ))}
        </div>
    )}

    {activeName && (
        <div class="space-y-2">
            {!hasPosts && <div class="rounded-2xl border border-dashed border-[var(--line-divider)] px-5 py-6 text-50">
                这个入口暂时没有文章。
            </div>}
            {posts.map((post) => (
                <a href={getPostUrlBySlug(post.slug)} class="group flex items-center justify-between gap-4 rounded-2xl px-4 py-3 hover:bg-[var(--btn-plain-bg-hover)] active:bg-[var(--btn-plain-bg-active)] transition">
                    <div class="min-w-0">
                        <div class="font-semibold text-75 group-hover:text-[var(--primary)] transition truncate">{post.data.title}</div>
                        <div class="text-sm text-30 mt-1 truncate">{post.data.description || post.data.tags?.join(" / ")}</div>
                    </div>
                    <Icon name="material-symbols:chevron-right-rounded" class="text-[1.5rem] text-[var(--primary)] shrink-0" />
                </a>
            ))}
        </div>
    )}
</section>
