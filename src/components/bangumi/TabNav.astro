---
interface Tab {
	id: string;
	name: string;
	count?: number;
}

interface Props {
	tabs: Tab[];
	activeTab: string;
}

const { tabs, activeTab } = Astro.props;
---

<div class="bangumi-tabs mb-5">
  <nav class="flex flex-wrap gap-2" aria-label="Tabs">
    {tabs.map((tab) => (
      <button
        class:list={[
          "bangumi-tab whitespace-nowrap rounded-full px-4 py-2 font-bold text-sm transition-all duration-200",
          {
            "tab-active": tab.id === activeTab,
            "tab-idle": tab.id !== activeTab
          }
        ]}
        data-tab={tab.id}
        type="button"
      >
        {tab.name}
        {tab.count !== undefined && (
          <span class="ml-2 rounded-full px-2 py-0.5 text-xs tab-count">
            {tab.count}
          </span>
        )}
      </button>
    ))}
  </nav>
</div>

<style>
  .bangumi-tabs {
    border-bottom: 1px solid var(--line-divider);
    padding-bottom: .9rem;
  }
  .bangumi-tab {
    border: 1px solid transparent;
  }
  .tab-active {
    color: white;
    background: linear-gradient(135deg, var(--primary), color-mix(in srgb, var(--accent-cyan) 46%, var(--primary)));
    box-shadow: 0 10px 24px color-mix(in srgb, var(--primary) 22%, transparent);
  }
  .tab-idle {
    color: var(--text-muted);
    background: color-mix(in srgb, var(--card-bg-solid) 58%, transparent);
    border-color: var(--glass-border);
  }
  .tab-idle:hover {
    color: var(--primary);
    background: var(--btn-plain-bg-hover);
  }
  .tab-count {
    background: color-mix(in srgb, white 28%, transparent);
  }
</style>

<script>
  function initTabNavigation() {
    const tabButtons = document.querySelectorAll('[data-tab]');
    const sections = document.querySelectorAll('[data-section]');

    tabButtons.forEach(button => {
      button.addEventListener('click', (event) => {
        const currentButton = event.currentTarget as HTMLButtonElement;
        const targetTab = currentButton.dataset.tab;

        // Update active tab
        tabButtons.forEach(btn => {
          btn.classList.remove('tab-active');
          btn.classList.add('tab-idle');
        });

        currentButton.classList.remove('tab-idle');
        currentButton.classList.add('tab-active');

        // Show/hide sections
        sections.forEach(section => {
          const htmlSection = section as HTMLElement;
          if (htmlSection.dataset.section === targetTab) {
            htmlSection.classList.remove('hidden');
          } else {
            htmlSection.classList.add('hidden');
          }
        });
      });
    });
  }

  // Initialize when DOM is ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initTabNavigation);
  } else {
    initTabNavigation();
  }
</script>
