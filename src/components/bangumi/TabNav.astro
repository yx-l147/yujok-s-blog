---
interface Tab {
	id: string;
	name: string;
	count?: number;
}

interface Props {
	tabs: Tab[];
	activeTab: string;
}

const { tabs, activeTab } = Astro.props;
---

<div class="liquid-tabbar mb-4" data-bangumi-tabs>
  <nav class="liquid-tabs" aria-label="Tabs">
    {tabs.map((tab) => (
      <button
        class:list={[
          "liquid-tab",
          {
            "liquid-tab-active": tab.id === activeTab
          }
        ]}
        data-tab={tab.id}
        aria-selected={tab.id === activeTab}
        type="button"
      >
        <span>{tab.name}</span>
        {tab.count !== undefined && (
          <span class="liquid-tab-count">
            {tab.count}
          </span>
        )}
      </button>
    ))}
  </nav>
</div>

<script>
  function initTabNavigation() {
    const tabbar = document.querySelector('[data-bangumi-tabs]') as HTMLElement | null;
    if (!tabbar || tabbar.dataset.bound === 'true') return;
    tabbar.dataset.bound = 'true';

    const tabButtons = Array.from(tabbar.querySelectorAll('[data-tab]'));
    const sections = Array.from(document.querySelectorAll('[data-bangumi-section]'));

    tabbar.addEventListener('click', (event) => {
      const currentButton = (event.target as Element).closest('[data-tab]') as HTMLButtonElement | null;
      if (!currentButton) return;

      const targetTab = currentButton.dataset.tab;
      if (!targetTab || currentButton.classList.contains('liquid-tab-active')) return;

      for (const btn of tabButtons) {
        const isActive = btn === currentButton;
        btn.classList.toggle('liquid-tab-active', isActive);
        btn.setAttribute('aria-selected', String(isActive));
      }

      for (const section of sections) {
        const htmlSection = section as HTMLElement;
        htmlSection.classList.toggle('hidden', htmlSection.dataset.bangumiSection !== targetTab);
      }
    });
  }

  // Initialize when DOM is ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initTabNavigation);
  } else {
    initTabNavigation();
  }
</script>
