---
---
<div id="star-canvas"></div>

<style>
  #star-canvas {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    z-index: 1;
    pointer-events: none;
  }
  #star-canvas canvas {
    width: 100%;
    height: 100%;
  }
</style>

<script>
class StarParticles {
  canvas: HTMLCanvasElement;
  ctx: CanvasRenderingContext2D;
  particles: Array<{
    x: number; y: number;
    vx: number; vy: number;
    radius: number;
    color: string;
    alpha: number;
    originalAlpha: number;
  }> = [];
  mouseX = 0;
  mouseY = 0;
  animationId = 0;

  constructor(canvas: HTMLCanvasElement) {
    this.canvas = canvas;
    this.ctx = canvas.getContext('2d')!;
    this.resize();
    this.init();
    this.animate();
    this.setupEvents();
  }

  resize() {
    this.canvas.width = window.innerWidth;
    this.canvas.height = window.innerHeight;
  }

  getColor() {
    return document.documentElement.classList.contains('dark')
      ? '180, 180, 180'
      : '100, 100, 100';
  }

  getLineColor() {
    return document.documentElement.classList.contains('dark')
      ? '100, 100, 100'
      : '150, 150, 150';
  }

  init() {
    this.particles = [];
    const count = Math.min(35, Math.floor(window.innerWidth / 35));
    const color = this.getColor();
    for (let i = 0; i < count; i++) {
      this.particles.push({
        x: Math.random() * this.canvas.width,
        y: Math.random() * this.canvas.height,
        vx: (Math.random() - 0.5) * 0.5,
        vy: (Math.random() - 0.5) * 0.5,
        radius: Math.random() * 2 + 1,
        color,
        alpha: Math.random() * 0.5 + 0.2,
        originalAlpha: Math.random() * 0.5 + 0.2,
      });
    }
  }

  setupEvents() {
    window.addEventListener('resize', () => {
      this.resize();
      this.init();
    });
    this.canvas.addEventListener('mousemove', (e) => {
      this.mouseX = e.clientX;
      this.mouseY = e.clientY;
    });
    // Theme change: re-init particles with new color
    const observer = new MutationObserver(() => this.init());
    observer.observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });
  }

  animate() {
    this.ctx.clearRect(0, 0, this.canvas.width, this.canvas.height);
    const lineColor = this.getLineColor();

    for (let i = 0; i < this.particles.length; i++) {
      const p = this.particles[i];
      p.x += p.vx;
      p.y += p.vy;
      if (p.x < 0 || p.x > this.canvas.width) p.vx *= -1;
      if (p.y < 0 || p.y > this.canvas.height) p.vy *= -1;

      const dx = this.mouseX - p.x;
      const dy = this.mouseY - p.y;
      const dist = Math.sqrt(dx * dx + dy * dy);
      p.alpha = dist < 150 ? Math.min(p.originalAlpha + 0.3, 1) : p.originalAlpha;

      this.ctx.beginPath();
      this.ctx.arc(p.x, p.y, p.radius, 0, Math.PI * 2);
      this.ctx.fillStyle = `rgba(${p.color}, ${p.alpha})`;
      this.ctx.fill();

      // Lines between nearby particles
      for (let j = i + 1; j < this.particles.length; j++) {
        const q = this.particles[j];
        const ddx = p.x - q.x;
        const ddy = p.y - q.y;
        const d = Math.sqrt(ddx * ddx + ddy * ddy);
        if (d < 150) {
          const opacity = (1 - d / 150) * 0.3;
          this.ctx.beginPath();
          this.ctx.moveTo(p.x, p.y);
          this.ctx.lineTo(q.x, q.y);
          this.ctx.strokeStyle = `rgba(${lineColor}, ${opacity})`;
          this.ctx.lineWidth = 0.5;
          this.ctx.stroke();
        }
      }
    }
    this.animationId = requestAnimationFrame(() => this.animate());
  }
}

document.addEventListener('DOMContentLoaded', () => {
  const container = document.getElementById('star-canvas');
  if (!container) return;
  const canvas = document.createElement('canvas');
  container.appendChild(canvas);
  new StarParticles(canvas);
});
</script>
